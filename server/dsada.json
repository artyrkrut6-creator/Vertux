interface Props {
  onSelect: (symbol: string) => void;
  selected?: string;
}

function fmtMMSS(ms: number) {
  const s = Math.max(0, Math.floor(ms / 1000));
  const mm = Math.floor(s / 60);
  const ss = s % 60;
  return `${mm}:${String(ss).padStart(2, '0')}`;
}

const Sidebar: React.FC<Props> = ({ onSelect, selected }) => {
  const coins = useScannerStore((s) => s.coins);
  const [now, setNow] = useState(Date.now());

  useEffect(() => {
    const t = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(t);
  }, []);

  const sorted = useMemo(() => {
    const arr = [...coins];
    arr.sort((a, b) => {
      if (a.tag !== b.tag) return a.tag === 'AI' ? -1 : 1; // AI first
      // AI: sooner expiry first, FT: higher volume first
      if (a.tag === 'AI') return a.expiresAt - b.expiresAt;
      return (b.quoteVolume || 0) - (a.quoteVolume || 0);
    });
    return arr;
  }, [coins]);

  return (
    <aside className="w-[320px] p-3">
      <div className="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md overflow-hidden">
        <div className="p-4 border-b border-white/10">
          <div className="text-lg font-semibold">Scanner</div>
          <div className="text-xs text-gray-400">AI (точные) / FT (для трейдеров)</div>
        </div>

        <div className="p-2 space-y-2 max-h-[78vh] overflow-y-auto">
          {sorted.map((c) => {
            const isSelected = selected === c.symbol;
            const timeLeft = c.expiresAt - now;

            const showTimer = c.tag === 'AI';
            const expired = timeLeft <= 0;

            // hide expired AI picks automatically (store also removes, but extra safety)
            if (expired) return null;

            const horizonMs = c.tag === 'AI' ? 5 * 60_000 : 10 * 60_000;
            const life = Math.max(1, (c.expiresAt - c.detectedAt) || horizonMs);
            const pct = Math.max(0, Math.min(100, (timeLeft / life) * 100));

            return (
              <div
                key={c.symbol}
                onClick={() => onSelect(c.symbol)}
                className={[
                  'p-3 rounded-xl border cursor-pointer transition',
                  isSelected ? 'bg-violet-500/20 border-violet-500/40' : 'bg-white/5 border-white/10 hover:bg-white/10'
                ].join(' ')}
              >
                <div className="flex items-start justify-between gap-2">
                  <div>
                    <div className="flex items-center gap-2">
                      <div className="font-semibold">{c.symbol}</div>
                      {c.tag === 'AI' ? (
                        <span className="text-[10px] px-2 py-0.5 rounded bg-violet-500/80 shadow-[0_0_12px_rgba(139,92,246,0.5)]">
                          AI
                        </span>
                      ) : (
                        <span className="text-[10px] px-2 py-0.5 rounded bg-orange-500/80">
                          FT
                        </span>
                      )}
                    </div>
                    <div className="text-xs text-gray-400 font-mono">
                      ${c.price < 1 ? c.price.toFixed(6) : c.price.toFixed(2)} • dev {c.stdDev.toFixed(3)}%
                    </div>
                  </div>

                  <div className="flex flex-col items-end gap-1">
                    {c.tag === 'AI' && (
                      <Flame className="w-5 h-5 text-violet-300 animate-pulse drop-shadow-[0_0_10px_rgba(139,92,246,0.8)]" />
                    )}
                    {showTimer && (
                      <div className="flex items-center gap-1 text-xs font-mono text-cyan-300">
                        <Clock className="w-3 h-3" />
                        {fmtMMSS(timeLeft)}
                      </div>
                    )}
                  </div>
                </div>

                {c.tag === 'AI' && (
