    // EXTRA CLEANUP: Extract JSON if wrapped in markdown code blocks
    if (content.includes('```json')) {
        content = content.split('```json')[1].split('```')[0].trim();
    } else if (content.includes('```')) {
        content = content.split('```')[1].split('```')[0].trim();
    }

    const parsed = JSON.parse(content);
    
    if (!parsed.target_price || !parsed.stop_loss_price || !parsed.forecast_1m) return null;

    const now = Date.now();
    const candles = parsed.forecast_1m.slice(0,5).map((c, i) => ({
       t: now + (i+1)*60000,
       close: Number(c.close)
    }));

    return {
        candles,
        target_price: Number(parsed.target_price),
        stop_loss_price: Number(parsed.stop_loss_price),
        direction: parsed.direction,
        confidence: Number(parsed.confidence)
    };

  } catch (e) { return null; }

