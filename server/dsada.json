import { create } from 'zustand';

export interface DetectedCoin {
  symbol: string;
  price: number;
  stdDev: number;
  detectedAt: number;
  expiresAt: number;
}

interface ScannerState {
  coins: DetectedCoin[];
  addDetectedCoin: (coin: DetectedCoin) => void;
  removeExpiredCoins: () => void;
}

export const useScannerStore = create<ScannerState>((set) => ({
  coins: [],

  addDetectedCoin: (newCoin) => set((state) => {
    // 1. Проверяем, есть ли монета уже в списке
    const exists = state.coins.find((c) => c.symbol === newCoin.symbol);
    
