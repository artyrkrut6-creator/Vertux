Код, который ты прислал, рабочий, но в нем есть один архитектурный недочет, который будет раздражать глаз: мерцание.

В текущей версии в последнем useEffect ты делаешь chart.removeSeries(...) и затем chart.add... каждый раз, когда приходят новые данные. Из-за этого график будет "передергиваться" при каждом обновлении.

Давай сделаем по "фен-шую": создадим серии один раз при инициализации графика, а при обновлении данных будем просто вызывать .setData().

Замени файл src/components/ChartContainer.tsx на этот оптимизированный вариант:

React

import React, { useEffect, useRef, useState } from 'react';
import { createChart, IChartApi, LineStyle, CandlestickData, LineData, ISeriesApi, ColorType } from 'lightweight-charts';

interface Props {
  symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = '—' }) => {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  
  // Refs для серий, чтобы не терять их между рендерами
  const candleSeriesRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const forecastSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);

  const [candles, setCandles] = useState<CandlestickData[]>([]);
  const [forecast, setForecast] = useState<LineData[]>([]);

  // 1. Инициализация графика (Один раз)
  useEffect(() => {
    if (!containerRef.current) return;

    // Создаем график
    const chart = createChart(containerRef.current, {
      width: containerRef.current.clientWidth,
      height: containerRef.current.clientHeight || 400,
      layout: {
        background: { type: ColorType.Solid, color: 'transparent' },
        textColor: '#9ca3af',
      },
      grid: {
        vertLines: { color: 'rgba(255, 255, 255, 0.05)' },
        horzLines: { color: 'rgba(255, 255, 255, 0.05)' },
      },
      crosshair: {
        horzLine: { color: '#8b5cf6', style: LineStyle.Dashed, labelBackgroundColor: '#8b5cf6' },
        vertLine: { color: '#8b5cf6', style: LineStyle.Dashed, labelBackgroundColor: '#8b5cf6' },
      },
      timeScale: {
        borderColor: 'rgba(255, 255, 255, 0.1)',
        timeVisible: true,
        secondsVisible: false,
      },
      rightPriceScale: {
        borderColor: 'rgba(255, 255, 255, 0.1)',
      },
    });

    // Создаем серии СРАЗУ (пустые)
    const candleSeries = chart.addCandlestickSeries({
      upColor: '#22c55e',
      downColor: '#ef4444',
      wickUpColor: '#22c55e',
      wickDownColor: '#ef4444',
      borderVisible: false,
    });
    
    const forecastSeries = chart.addLineSeries({
      color: '#8b5cf6', // Electric Violet
      lineWidth: 2,
      lineStyle: LineStyle.Dashed, // Пунктир для прогноза
      title: 'AI Forecast',
    });

    // Сохраняем в рефы
    chartRef.current = chart;
    candleSeriesRef.current = candleSeries;
    forecastSeriesRef.current = forecastSeries;

    // Авто-ресайз
    const resizeObserver = new ResizeObserver(() => {
      if (containerRef.current && chartRef.current) {
        chartRef.current.applyOptions({ 
          width: containerRef.current.clientWidth,
          height: containerRef.current.clientHeight 
        });
      }
    });
    resizeObserver.observe(containerRef.current);

    return () => {
      resizeObserver.disconnect();
      chart.remove();
    };
  }, []);

  // 2. Загрузка исторических данных (Свечи)
  useEffect(() => {
    if (!symbol || symbol === '—') return;

    const fetchCandles = async () => {
      try {
        console.log(`[ChartContainer] loading candles for ${symbol}`);
        const response = await fetch(`/api/live/candles?symbol=${symbol}&limit=50`);
        if (!response.ok) throw new Error('Failed to fetch candles');
        
        const data = await response.json();
        // Преобразуем и обязательно СОРТИРУЕМ по времени, иначе график упадет
        const formatted = data
          .map((c: any) => ({
            time: Math.floor(c.time), // секунды
            open: Number(c.open),
            high: Number(c.high),
            low: Number(c.low),
            close: Number(c.close),
          }))
          .sort((a: any, b: any) => a.time - b.time);

        setCandles(formatted);
      } catch (error) {
        console.error('Error fetching candles:', error);
      }
    };

    fetchCandles();
  }, [symbol]);

  // 3. Загрузка прогноза (Forecast)
  useEffect(() => {
    const fetchForecast = async () => {
      try {
        const response = await fetch('/api/scheduler/latest');
        if (!response.ok) throw new Error('Failed to fetch forecast');
        
        const data = await response.json();
        const parsed = data.parsed || data;

        if (parsed.forecast_1m && Array.isArray(parsed.forecast_1m)) {
          const formatted = parsed.forecast_1m
            .map((f: any) => ({
              time: Math.floor(f.t / 1000), // конвертация ms -> sec
              value: Number(f.close),
            }))
            .sort((a: any, b: any) => a.time - b.time);
            
          setForecast(formatted);
        }
      } catch (error) {
        console.error('Error fetching forecast:', error);
      }
    };

    fetchForecast();
    // Можно добавить интервал для обновления прогноза
  }, [symbol]); // Обновляем прогноз при смене символа (или можно оставить пустым для глобального обновления)

  // 4. Обновление данных на графике (без пересоздания серий)
  useEffect(() => {
    if (!candleSeriesRef.current || !forecastSeriesRef.current) return;

    // Обновляем свечи
    if (candles.length > 0) {
      candleSeriesRef.current.setData(candles);
    }

    // Обновляем прогноз
    if (forecast.length > 0) {
      forecastSeriesRef.current.setData(forecast);
    }
    
    // Если есть данные, масштабируем график, чтобы вместить всё
    if (chartRef.current && (candles.length > 0 || forecast.length > 0)) {
       chartRef.current.timeScale().fitContent();
    }

  }, [candles, forecast]);

  return (
    // Добавили неоновую тень контейнеру
    <div className="w-full h-full relative drop-shadow-[0_0_15px_rgba(139,92,246,0.15)]">
      <div ref={containerRef} className="w-full h-full" />
      
      {/* Если нет символа, показываем заглушку */}
      {symbol === '—' && (
        <div className="absolute inset-0 flex items-center justify-center text-gray-500 pointer-events-none">
          Select a coin to analyze
        </div>
      )}
    </div>
  );
};

export default ChartContainer;

