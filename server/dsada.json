const sym = req.query.symbol || 'BTCUSDT';
const iv = setInterval(async () => {
const kl = await fetchMexcKlines(sym, '1m', 1);
if (kl.length) {
const k = kl[0];
res.write(event: candle_update\ndata: ${JSON.stringify({time:Number(k[0])/1000,open:Number(k[1]),high:Number(k[2]),low:Number(k[3]),close:Number(k[4])})}\n\n);
}
}, 2000);
req.on('close', () => clearInterval(iv));
});

app.get('/api/scheduler/latest', (req, res) => {
if (fs.existsSync(DATA_FILE)) res.json(JSON.parse(fs.readFileSync(DATA_FILE))); else res.json({});
});

app.listen(PORT, () => {
// Load persisted signals (if any) before starting
try { loadPersistedSignals(); } catch (e) { /* ignore / }
// Write initial snapshot so clients receive persisted signals immediately
try {
const initialDetected = [];
const initialForecasts = {};
for (const [sym, sig] of activeSignals.entries()) {
initialDetected.push(Object.assign({}, sig));
if (sig.forecastCandles) {
initialForecasts[sym] = {
generatedAt: sig.addedAt || Date.now(),
