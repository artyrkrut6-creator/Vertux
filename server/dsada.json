React

import React, { useEffect, useMemo, useState } from 'react';
import useScannerStore from '../store/scannerStore';
import { Flame, Clock, TrendingUp, TrendingDown, BarChart3 } from 'lucide-react';

interface Props {
  onSelect: (symbol: string) => void;
  selected?: string;
}

function fmtMMSS(ms: number) {
  const s = Math.max(0, Math.floor(ms / 1000));
  const mm = Math.floor(s / 60);
  const ss = s % 60;
  return `${mm}:${String(ss).padStart(2, '0')}`;
}

function fmtVol(n?: number) {
  const v = Number(n || 0);
  if (!Number.isFinite(v) || v <= 0) return '--';
  if (v >= 1e9) return `${(v / 1e9).toFixed(2)}B`;
  if (v >= 1e6) return `${(v / 1e6).toFixed(2)}M`;
  if (v >= 1e3) return `${(v / 1e3).toFixed(2)}K`;
  return `${v.toFixed(0)}`;
}

function fmtPrice(p: number) {
  const v = Number(p);
  if (!Number.isFinite(v)) return '--';
  let d = 2;
  if (v < 1000) d = 4;
  if (v < 1) d = 6;
  if (v < 0.01) d = 8;
  const s = v.toFixed(d);
  return s.replace(/\.?0+$/, '');
}

const Sidebar: React.FC<Props> = ({ onSelect, selected }) => {
  const coins = useScannerStore((s) => s.coins);
  const [now, setNow] = useState(Date.now());

  useEffect(() => {
    const t = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(t);
  }, []);

  const sorted = useMemo(() => {
    const arr = [...coins];
    arr.sort((a, b) => {
      if (a.tag !== b.tag) return a.tag === 'AI' ? -1 : 1; // AI first
      if (a.tag === 'AI') return a.expiresAt - b.expiresAt; // earlier expiry first
      return (b.quoteVolume || 0) - (a.quoteVolume || 0); // FT: higher volume first
    });
    return arr;
  }, [coins]);

  return (
    <aside className="w-[360px] p-3">
      <div className="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md overflow-hidden">
        <div className="p-4 border-b border-white/10 bg-black/20">
          <div className="text-lg font-semibold">Scanner</div>
          <div className="text-xs text-gray-400">
            AI — прогноз 5 минут • FT — for traders
          </div>
        </div>

        <div className="p-2 space-y-2 max-h-[78vh] overflow-y-auto">
          {sorted.map((c) => {
            const isSelected = selected === c.symbol;
            const timeLeft = c.expiresAt - now;
            if (timeLeft <= 0) return null;

            const isAI = c.tag === 'AI';
            const horizonMs = isAI ? 5 * 60_000 : 10 * 60_000;
            const life = Math.max(1, (c.expiresAt - c.detectedAt) || horizonMs);
            const pct = Math.max(0, Math.min(100, (timeLeft / life) * 100));

            const ch = Number(c.change24hPct ?? 0);
            const chPos = ch >= 0;
            const chColor = chPos ? 'text-green-400' : 'text-red-400';

            return (
              <div
                key={c.symbol}
                onClick={() => onSelect(c.symbol)}
                className={[
                  'p-3 rounded-xl border cursor-pointer transition',
                  isSelected
                    ? 'bg-violet-500/20 border-violet-500/40 shadow-[0_0_18px_rgba(139,92,246,0.18)]'
                    : 'bg-white/5 border-white/10 hover:bg-white/10',
                ].join(' ')}
              >
                <div className="flex items-start justify-between gap-3">
                  <div className="min-w-0">
                    <div className="flex items-center gap-2">
                      <div className="font-semibold truncate">{c.symbol}</div>

                      {isAI ? (
                        <span className="text-[10px] px-2 py-0.5 rounded bg-violet-500/80 shadow-[0_0_12px_rgba(139,92,246,0.45)]">
                          AI
                        </span>
                      ) : (
                        <span className="text-[10px] px-2 py-0.5 rounded bg-orange-500/80">
                          FT
                        </span>
                      )}
                    </div>

                    <div className="mt-1 flex items-center gap-3 text-xs font-mono text-gray-200">
                      <span className="text-gray-400">Price</span>
                      <span>${fmtPrice(c.price)}</span>

                      <span className={`flex items-center gap-1 ${chColor}`}>
                        {chPos ? <TrendingUp className="w-3 h-3" /> : <TrendingDown className="w-3 h-3" />}
                        {Number.isFinite(ch) ? `${chPos ? '+' : ''}${ch.toFixed(2)}%` : '--'}
                        <span className="text-gray-500">(24h)</span>
                      </span>
                    </div>

                    <div className="mt-1 flex items-center gap-3 text-xs font-mono text-gray-300">
                      <span className="flex items-center gap-1 text-gray-400">
                        <BarChart3 className="w-3 h-3" />
                        Vol24h
                      </span>
                      <span>${fmtVol(c.quoteVolume)}</span>

                      <span className="text-gray-500">•</span>

                      <span className="text-gray-400">StdDev</span>
                      <span>{Number.isFinite(c.stdDev) ? `${c.stdDev.toFixed(3)}%` : '--'}</span>
                    </div>
                  </div>

                  <div className="flex flex-col items-end gap-2">
                    {isAI && (
                      <Flame className="w-5 h-5 text-violet-300 animate-pulse drop-shadow-[0_0_10px_rgba(139,92,246,0.8)]" />
                    )}

                    {isAI && (
                      <div className="flex items-center gap-1 text-xs font-mono text-cyan-300">
                        <Clock className="w-3 h-3" />
                        {fmtMMSS(timeLeft)}
                      </div>
                    )}
                  </div>
                </div>

                {isAI && (
                  <div className="mt-2 h-[2px] w-full bg-white/10 rounded">
                    <div
                      className="h-full bg-violet-400 rounded"
                      style={{ width: `${pct}%`, transition: 'width 1s linear' }}
                    />
                  </div>
                )}
              </div>
            );
          })}

          {sorted.length === 0 && (
            <div className="p-6 text-center text-sm text-gray-500">
              Сканирую рынок… ожидаю сигналы
            </div>
          )}
        </div>
      </div>
    </aside>
  );
};

export default Sidebar;

