    // Clear lines
    if (targetLineRef.current) { candleRef.current?.removePriceLine(targetLineRef.current); targetLineRef.current = null; }
    if (stopLossLineRef.current) { candleRef.current?.removePriceLine(stopLossLineRef.current); stopLossLineRef.current = null; }
  }, [symbol]);

  // 2. Fetch History & Forecast
  useEffect(() => {
    let active = true;
    
    // Parallel fetch for speed
    Promise.all([
        fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol || 'BTCUSDT')}&limit=120`).then(r => r.json()),
        fetch('/api/scheduler/latest').then(r => r.json())
    ]).then(([candlesData, forecastData]) => {
        if (!active) return;

        // Process Candles
        const formatted = (Array.isArray(candlesData) ? candlesData : []).map((c: any) => ({
          time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close)
        })).sort((a: any, b: any) => a.time - b.time);
        
        // Process Forecast
        const parsed = forecastData?.parsed || forecastData;
        const pack = parsed?.forecastsBySymbol?.[String(symbol).toUpperCase()];
        const validPack = (pack && pack.source === 'deepseek') ? pack : null;

        // Start "Build" Animation
        if (formatted.length > 0) {
            setFullCandles(formatted);
            setForecastPack(validPack);
            // Don't stop loading yet, we will "build" the chart
        } else {
            setIsLoading(false); // No data, just show empty
        }
    }).catch(() => setIsLoading(false));

    return () => { active = false; };
  }, [symbol]);

  // 3. Init Chart
  useEffect(() => {
    if (!containerRef.current) return;
    if (chartRef.current) chartRef.current.remove();

    const chart = createChart(containerRef.current, {
      width: containerRef.current.clientWidth,
      height: containerRef.current.clientHeight,
      layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: '#9ca3af' },
      grid: { vertLines: { color: 'rgba(255,255,255,0.02)' }, horzLines: { color: 'rgba(255,255,255,0.02)' } },
      timeScale: { timeVisible: true, secondsVisible: false, borderVisible: false },
      rightPriceScale: { borderVisible: false },
      crosshair: { vertLine: { color: '#8b5cf6', style: LineStyle.Dashed }, horzLine: { color: '#8b5cf6', style: LineStyle.Dashed } }
    });
    
    chartRef.current = chart;
    candleRef.current = chart.addCandlestickSeries({ upColor: '#22c55e', downColor: '#ef4444', wickUpColor: '#22c55e', wickDownColor: '#ef4444' });
    forecastRef.current = chart.addLineSeries({ color: '#8b5cf6', lineWidth: 2, lineStyle: LineStyle.Dashed });

    const ro = new ResizeObserver(() => {
      if (chartRef.current && containerRef.current) {
        chartRef.current.applyOptions({ width: containerRef.current.clientWidth, height: containerRef.current.clientHeight });
      }
    });
    ro.observe(containerRef.current);

    return () => { ro.disconnect(); chart.remove(); chartRef.current = null; };
  }, []);

  // 4. PROGRESSIVE DRAWING ANIMATION
  useEffect(() => {
    if (!fullCandles.length || !candleRef.current) return;

    let index = 0;
    const total = fullCandles.length;
    // Draw in 1.5 seconds total (60fps) -> approx total/90 chunks per frame
    const chunkSize = Math.max(1, Math.ceil(total / 40)); 

    const animate = () => {
        if (!candleRef.current) return;
        
        const nextBatch = fullCandles.slice(0, index + chunkSize);
        candleRef.current.setData(nextBatch);
        
        index += chunkSize;

        if (index < total) {
            requestAnimationFrame(animate);
        } else {
            // Animation Done -> Show Forecast & Lines
            if (forecastPack && forecastRef.current) {
                const line = forecastPack.candles.map((c: any) => ({ time: Math.floor(c.t/1000), value: c.close }));
                forecastRef.current.setData(line);
                // Draw Lines
                if (forecastPack.target_price) {
                    targetLineRef.current = candleRef.current.createPriceLine({
                        price: Number(forecastPack.target_price),
                        color: forecastPack.direction === 'SHORT' ? '#ef4444' : '#22c55e',
                        lineWidth: 2, lineStyle: LineStyle.Solid, title: 'TARGET', axisLabelVisible: true
                    });
                }
                if (forecastPack.stop_loss_price) {
                    stopLossLineRef.current = candleRef.current.createPriceLine({
                        price: Number(forecastPack.stop_loss_price),
                        color: '#ef4444', lineWidth: 1, lineStyle: LineStyle.Dotted, title: 'STOP', axisLabelVisible: true
                    });
                }
            }
            setIsLoading(false); // Hide Loader
        }
    };

    // Start Animation Loop
    requestAnimationFrame(animate);

  }, [fullCandles, forecastPack]);

  // 5. Live Stream (Only after loading)
  useEffect(() => {
    if (isLoading) return; // Don't stream while animating
    const es = new EventSource(`/api/live/stream?symbol=${encodeURIComponent(symbol || 'BTCUSDT')}`);
    es.addEventListener('candle_update', (ev) => {
        try {
            const c = JSON.parse(ev.data);
            if (candleRef.current) candleRef.current.update({ time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close) });
        } catch (_) {}
    });
    return () => es.close();
  }, [symbol, isLoading]);

  return (
    <div className="w-full h-full relative overflow-hidden bg-transparent">
      
      {/* LOADER OVERLAY */}
      <AnimatePresence>
        {isLoading && (
          <motion.div
            initial={{ opacity: 1 }} exit={{ opacity: 0 }}
            className="absolute inset-0 z-50 flex items-center justify-center bg-[#050505]"
          >
            {/* Grid & Scan Lines */}
            <div className="absolute inset-0 grid grid-cols-12 gap-1 opacity-10">
               {[...Array(12)].map((_, i) => <div key={i} className="h-full border-r border-violet-500/20" />)}
            </div>
            <div className="absolute inset-0 bg-gradient-to-b from-transparent via-violet-500/5 to-transparent animate-scan-vertical" />
            
            <div className="relative z-10 flex flex-col items-center">
               <div className="w-12 h-12 border-2 border-t-violet-500 border-r-transparent border-b-violet-500 border-l-transparent rounded-full animate-spin" />
               <span className="mt-4 text-xs font-mono text-violet-400 tracking-[0.2em] animate-pulse">
                 INITIALIZING NEURAL LINK...
               </span>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      <div ref={containerRef} className="w-full h-full" />

      <style>{`
        @keyframes scan-vertical {
          0% { transform: translateY(-100%); }
          100% { transform: translateY(100%); }
        }
        .animate-scan-vertical { animation: scan-vertical 2s linear infinite; }
      `}</style>
    </div>
  );
};

export default ChartContainer;

