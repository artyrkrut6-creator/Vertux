JavaScript

// Adaptive AI picker: Parallel execution for speed
async function pickAiWithAdaptiveGates(aiPool) {
  const adaptiveSteps = [
    { name: 'step1', gates: { maxSpreadPct: 0.20, minDepth: 25_000, stddevMax: 0.18, backtestMean: 0.20, backtestMax: 0.45 } },
    { name: 'step2', gates: { maxSpreadPct: 0.25, minDepth: 15_000, stddevMax: 0.22, backtestMean: 0.25, backtestMax: 0.60 } },
    { name: 'step3', gates: { maxSpreadPct: 0.30, minDepth: 10_000, stddevMax: 0.28, backtestMean: 0.35, backtestMax: 0.80 } },
  ];

  const accepted = [];
  const stages = [];
  const localDemoteCounts = { lowPriceVol:0, spreadDepth:0, stddev:0, backtestError:0, backtestThreshold:0, directionalFail:0, insufficientKlines:0 };
  
  // Clone pool to avoid mutation issues
  const pool = aiPool.slice();

  for (const step of adaptiveSteps) {
    // 1. Cheap Filters (Sequential but fast)
    const passedCheap = [];
    const gates = step.gates;

    for (const t of pool) {
        if (t.quoteVolume < MIN_QUOTEVOL_AI) { localDemoteCounts.lowPriceVol++; continue; }
        if (t.lastPrice < MIN_PRICE_AI) { localDemoteCounts.lowPriceVol++; continue; }
        if (Math.abs(Number(t.priceChangePercent || 0)) > 10) { localDemoteCounts.stddev++; continue; }

        // We assume t._klines might not be populated or needs refresh, but for speed we skip refetch here if pool is huge
        // Let's assume we do need to check klines size/stddev if not checked before.
        // For simplicity in this logic, we rely on the shortlist step to do heavy lifting.
        
        passedCheap.push(t);
    }

    // Sort: low volatility preferred for AI
    // We need to fetch klines/depth for the TOP candidates now.
    // Let's take TOP 8 candidates to check depth/spread.
    const candidatesToCheck = passedCheap.slice(0, 8);
    
    const validCandidates = [];

    // Parallel Fetch Depth/Spread for these 8
    await Promise.all(candidatesToCheck.map(async (t) => {
        try {
            const depth = await fetchMexcDepth(t.symbol, 20);
            if (!depth || !depth.bids.length || !depth.asks.length) return;
            
            const bestBid = Number(depth.bids[0][0]);
            const bestAsk = Number(depth.asks[0][0]);
            const mid = (bestBid + bestAsk) / 2;
            const spreadPct = ((bestAsk - bestBid) / mid) * 100;
            
            // Calc Depth USDT
            const bidThreshold = mid * (1 - DEPTH_BAND_PCT/100);
            const askThreshold = mid * (1 + DEPTH_BAND_PCT/100);
            let bidUSDT = 0; 
            for(let b of depth.bids) if(Number(b[0]) >= bidThreshold) bidUSDT += Number(b[0])*Number(b[1]);
            let askUSDT = 0; 
            for(let a of depth.asks) if(Number(a[0]) <= askThreshold) askUSDT += Number(a[0])*Number(a[1]);
            const depthUSDT = Math.min(bidUSDT, askUSDT);

            if (spreadPct > gates.maxSpreadPct || depthUSDT < gates.minDepth) {
                localDemoteCounts.spreadDepth++;
                return;
            }

            // Klines check (stdDev)
            const kl15 = await fetchMexcKlines(t.symbol, '1m', 15);
            const closes = kl15.map(k=>Number(k[4]));
            const devPct = relStdDevPct(closes);
            
            if (devPct > gates.stddevMax) {
                localDemoteCounts.stddev++;
                return;
            }

            validCandidates.push({ ...t, spreadPct, depthUSDT, stdDev: devPct });

        } catch (e) { localDemoteCounts.backtestError++; }
    }));

    // Now we have valid candidates. Sort by best metrics.
    const shortlist = validCandidates.sort((a,b) => (a.stdDev - b.stdDev) || (b.quoteVolume - a.quoteVolume)).slice(0, 5);

    // 2. PARALLEL DEEPSEEK BOMBARDMENT
    // We launch all 5 requests at once.
    const aiResults = await Promise.all(shortlist.map(async (candidate) => {
        try {
            const kl40 = await fetchMexcKlines(candidate.symbol, '1m', BACKTEST_KLINES);
            const closes40 = kl40.map(k => Number(k[4]));
            if (closes40.length < BACKTEST_KLINES) return null;

            const ctx35 = kl40.slice(0,35).map(k => ({ open:Number(k[1]), high:Number(k[2]), low:Number(k[3]), close:Number(k[4]), time:Number(k[0]) }));
            const actual5 = kl40.slice(35,40).map(k => Number(k[4]));

            // Parallel Request 1: Backtest
            const dsBack = await deepseekForecast5(candidate.symbol, ctx35);
            if (!dsBack || dsBack.error || !dsBack.candles) return null;

            // Check Error
            const preds = dsBack.candles.map(c => Number(c.close));
            const pctErrs = preds.map((p,i) => Math.abs((p - actual5[i]) / actual5[i]) * 100);
            const meanAbsPctErr = pctErrs.reduce((s,v)=>s+v,0)/pctErrs.length;
            const maxAbsPctErr = Math.max(...pctErrs);

            if (meanAbsPctErr > gates.backtestMean || maxAbsPctErr > gates.backtestMax) return null;

            // Directional Check
            let dirMatches = 0;
            for (let i=1;i<preds.length;i++) {
                if (Math.sign(actual5[i]-actual5[i-1]) === Math.sign(preds[i]-preds[i-1])) dirMatches++;
            }
            if (dirMatches < 3) return null;

            // Parallel Request 2: Future Forecast (Sniper)
            const recentKl = await fetchMexcKlines(candidate.symbol, '1m', 30); // Optimised context
            const recentCtx = recentKl.map(k => ({ time: Number(k[0]), open:Number(k[1]), high:Number(k[2]), low:Number(k[3]), close:Number(k[4]) }));
            
            const dsFuture = await deepseekForecast5(candidate.symbol, recentCtx);
            if (!dsFuture || dsFuture.error || !dsFuture.candles) return null;

            // Valid AI Pick!
            return {
                ...candidate,
                forecastCandles: dsFuture.candles,
                target_price: dsFuture.target_price,
                stop_loss_price: dsFuture.stop_loss_price,
                direction: dsFuture.direction
            };

        } catch (e) { return null; }
    }));

    // Filter successful results
    const stepAccepted = aiResults.filter(r => r !== null);
    
    for (const r of stepAccepted) accepted.push(r);

    stages.push({ stepName: step.name, gates: step.gates, passedCheapFilters: passedCheap.length, backtestTried: shortlist.length, backtestPassed: stepAccepted.length });

    if (accepted.length >= 1) break; // We found gems, stop relaxing gates
  }

  // Merge counters
  for (const k of Object.keys(localDemoteCounts)) lastDemoteReasonCounts[k] = (lastDemoteReasonCounts[k]||0) + localDemoteCounts[k];
  
  lastAiAttemptStages = stages;
  lastAiPickCount = accepted.length;

  return accepted.slice(0, 2); // Return top 2
}

