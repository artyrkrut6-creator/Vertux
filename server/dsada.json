function isSaneUsdtSymbol(sym) {
return /^[A-Z0-9]{2,}USDT$/.test(sym);
}

function isStablecoinLike(sym) {
return /USDC|USDP|TUSD|DAI|FDUSD|USD1|USDE|PAXG|EUR|GBP/.test(sym);
