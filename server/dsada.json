import React, { useEffect, useMemo, useState } from 'react';
import useScannerStore from '../store/scannerStore';
import { Flame, Clock, TrendingUp, TrendingDown, BarChart3, ScanLine } from 'lucide-react';

interface Props {
  onSelect: (symbol: string) => void;
  selected?: string;
}

// Форматирование времени MM:SS
function fmtMMSS(ms: number) {
  if (ms <= 0) return "00:00";
  const s = Math.floor(ms / 1000);
  const mm = Math.floor(s / 60);
  const ss = s % 60;
  return `${mm}:${String(ss).padStart(2, '0')}`;
}

// Форматирование объема (1M, 500K)
function fmtVol(n?: number) {
  const v = Number(n || 0);
  if (!Number.isFinite(v) || v <= 0) return '--';
  if (v >= 1e9) return `${(v / 1e9).toFixed(2)}B`;
  if (v >= 1e6) return `${(v / 1e6).toFixed(2)}M`;
  if (v >= 1e3) return `${(v / 1e3).toFixed(0)}K`;
  return `${v.toFixed(0)}`;
}

// Форматирование цены
function fmtPrice(p: number) {
  const v = Number(p);
  if (!Number.isFinite(v)) return '--';
  let d = 2;
  if (v < 1000) d = 3;
  if (v < 1) d = 5;
  if (v < 0.01) d = 7;
  return v.toFixed(d).replace(/\.?0+$/, '');
}

const Sidebar: React.FC<Props> = ({ onSelect, selected }) => {
  // Достаем монеты и время следующего скана из стора
  const { coins, nextScanAt } = useScannerStore((state) => ({
    coins: state.coins,
    nextScanAt: state.nextScanAt // Убедись, что добавил это поле в store
  }));
  
  const [now, setNow] = useState(Date.now());

  // Обновляем таймер каждую секунду
  useEffect(() => {
    const t = setInterval(() => setNow(Date.now()), 1000);
    return () => clearInterval(t);
  }, []);

  const sorted = useMemo(() => {
    const arr = [...coins];
    arr.sort((a, b) => {
      // Сначала AI, потом остальные
      if (a.tag !== b.tag) return a.tag === 'AI' ? -1 : 1; 
      // Внутри AI сортируем по времени истечения
      if (a.tag === 'AI') return a.expiresAt - b.expiresAt;
      // Внутри FT сортируем по объему
      return (b.quoteVolume || 0) - (a.quoteVolume || 0);
    });
    return arr;
  }, [coins]);

  // Таймер до следующего скана
  const timeToNextScan = (nextScanAt || 0) - now;
  const isScanning = timeToNextScan <= 0;

  return (
    <aside className="w-[360px] h-[calc(100vh-40px)] flex flex-col p-2">
      <div className="flex-1 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md overflow-hidden flex flex-col shadow-2xl">
        
        {/* HEADER */}
        <div className="p-4 border-b border-white/10 bg-black/40">
          <div className="flex justify-between items-center">
            <h2 className="text-lg font-bold text-white tracking-wide">MARKET SCANNER</h2>
            {/* Status Indicator */}
            <div className={`w-2 h-2 rounded-full ${isScanning ? 'bg-yellow-400 animate-ping' : 'bg-green-500'}`} />
          </div>
          <div className="text-xs text-gray-400 mt-1 flex gap-2">
            <span className="text-violet-400 font-bold">AI: Sniper Mode</span>
            <span className="text-gray-600">|</span>
            <span className="text-orange-400 font-bold">FT: Trading Zones</span>
          </div>
        </div>

        {/* COIN LIST */}
        <div className="flex-1 overflow-y-auto p-2 space-y-2 custom-scrollbar">
          {sorted.map((c) => {
            const isAI = c.tag === 'AI';
            const timeLeft = c.expiresAt - now;
            
            // Если AI прогноз истек, скрываем его из списка (или делаем серым)
            if (isAI && timeLeft <= 0) return null;

            // Вычисляем прогресс бар для AI (5 минут жизни)
            const lifeTime = 5 * 60 * 1000; 
            const progress = Math.min(100, Math.max(0, (timeLeft / lifeTime) * 100));

            // Логика бейджей для FT (Long/Short)
            let badge = null;
            if (isAI) {
              badge = <span className="bg-violet-600 text-white text-[10px] px-2 py-0.5 rounded shadow-[0_0_10px_#7c3aed]">AI SNIPER</span>;
            } else if (c.signal === 'LONG') {
              badge = <span className="bg-green-600 text-white text-[10px] px-2 py-0.5 rounded shadow-[0_0_10px_#16a34a]">LONG ZONE</span>;
            } else if (c.signal === 'SHORT') {
              badge = <span className="bg-red-600 text-white text-[10px] px-2 py-0.5 rounded shadow-[0_0_10px_#dc2626]">SHORT ZONE</span>;
            } else {
              badge = <span className="bg-orange-500/20 text-orange-300 text-[10px] px-2 py-0.5 rounded">VOLATILE</span>;
            }

            const isSelected = selected === c.symbol;

            return (
              <div
                key={c.symbol}
                onClick={() => onSelect(c.symbol)}
                className={`
                  relative p-3 rounded-xl border transition-all cursor-pointer overflow-hidden
                  ${isSelected 
                    ? 'bg-white/10 border-violet-500/50 shadow-[0_0_15px_rgba(139,92,246,0.2)]' 
                    : 'bg-white/5 border-white/5 hover:bg-white/10 hover:border-white/20'}
                `}
              >
                <div className="flex justify-between items-start z-10 relative">
                  {/* Left: Info */}
                  <div>
                    <div className="flex items-center gap-2 mb-1">
                      <span className="font-bold text-md text-gray-100">{c.symbol}</span>
                      {badge}
                    </div>
                    
                    <div className="flex items-center gap-3 text-xs font-mono text-gray-400">
                      <span className="text-white">${fmtPrice(c.price)}</span>
                      <span className="flex items-center gap-1">
                        <BarChart3 className="w-3 h-3" />
                        {fmtVol(c.quoteVolume)}
                      </span>
                    </div>
                  </div>

                  {/* Right: Timer / Flame */}
                  <div className="flex flex-col items-end">
                    {isAI && (
                      <>
                        <Flame className="w-4 h-4 text-violet-400 fill-violet-400/20 animate-pulse mb-1" />
                        <div className="text-xs font-mono text-cyan-300 flex items-center gap-1">
                          <Clock className="w-3 h-3" />
                          {fmtMMSS(timeLeft)}
                        </div>
                      </>
                    )}
                    {/* Для FT показываем изменение цены */}
                    {!isAI && (
                      <span className={`${(c.change24hPct || 0) >= 0 ? 'text-green-400' : 'text-red-400'} text-xs font-bold`}>
                        {(c.change24hPct || 0) > 0 ? '+' : ''}{(c.change24hPct || 0).toFixed(2)}%
                      </span>
                    )}
                  </div>
                </div>

                {/* Progress Bar for AI */}
                {isAI && (
                  <div className="absolute bottom-0 left-0 w-full h-[3px] bg-gray-700">
                    <div 
                      className="h-full bg-gradient-to-r from-violet-600 to-cyan-500" 
                      style={{ width: `${progress}%`, transition: 'width 1s linear' }}
                    />
                  </div>
                )}
              </div>
            );
          })}

          {sorted.length === 0 && (
            <div className="flex flex-col items-center justify-center h-40 text-gray-500 text-sm">
              <ScanLine className="w-8 h-8 mb-2 opacity-50 animate-spin-slow" />
              <span>Scanning Market...</span>
            </div>
          )}
        </div>

        {/* FOOTER: NEXT SCAN TIMER */}
        <div className="p-3 bg-black/60 border-t border-white/10 text-center">
          {isScanning ? (
            <div className="text-yellow-400 text-xs font-bold animate-pulse flex justify-center items-center gap-2">
              SCANNING NEW SIGNALS...
            </div>
          ) : (
            <div className="text-xs font-mono text-gray-400 flex justify-between items-center px-2">
              <span>Next Updates:</span>
              <span className="text-cyan-400 font-bold text-sm">{fmtMMSS(timeToNextScan)}</span>
            </div>
          )}
          {/* Progress bar for next scan */}
          {!isScanning && (
             <div className="w-full h-1 bg-gray-800 mt-2 rounded-full overflow-hidden">
               {/* 300000 = 5 minutes hardcoded, better to read from config if possible */}
               <div 
                 className="h-full bg-cyan-600" 
                 style={{ width: `${100 - (timeToNextScan / 300000) * 100}%`, transition: 'width 1s linear' }} 
               />
             </div>
          )}
        </div>

      </div>
    </aside>
  );
};

export default Sidebar;

2. Как работает "Мозг" сканера (Ответ на твой вопрос)

Ты спросил: "как вообще работает фильтр для аи... типо строго прям все подбирается а потом у дипсика спрашивает?"

Ответ: ДА, именно так. Это многоступенчатая воронка.

Представь это как кастинг в элитный отряд.

    ЭТАП 1: "Толпа" (Все монеты)
    Сервер берет ВСЕ 2500+ монет с биржи.

    ЭТАП 2: "Фейс-контроль" (Жесткий фильтр)
    Отсеиваем мусор.
        Ликвидность: Объем торгов должен быть огромным (например, > $3,000,000 в сутки). Если меньше — "До свидания", кит такую монету сломает.
        Адекватность: Исключаем странные токены (UP/DOWN/BEAR), стейблкоины.
        На этом этапе из 2500 остается штук 100-200.

    ЭТАП 3: "Медосмотр" (Глубина и Спред)
    Сервер лезет в стакан (Order Book) каждой из этих монет.
        Спред: Разница между покупкой и продажей должна быть мизерной (< 0.2%).
        Стенки: В стакане должно лежать много денег (Depth), чтобы цену нельзя было сдвинуть одной котлетой.
        Остается монет 20-30.

    ЭТАП 4: "Экзамен" (Бэктест DeepSeek)
    Вот тут начинается магия. Мы берем ТОП-3 лучших кандидатов и отправляем их данные в прошлое к DeepSeek.
        Мы даем ему график за прошлый час (но прячем последние 5 минут).
        Говорим: "Предскажи, что случилось в эти скрытые 5 минут".
        DeepSeek делает прогноз.
        Мы сравниваем прогноз с реальностью.
        ЕСЛИ ОН УГАДАЛ (ошибка минимальна, направление верное) -> Поздравляем, ты в отряде "AI".
        Если ошибся -> "Ты не прошел, иди в отряд FT".

    ЭТАП 5: "Боевая задача"
    Только для тех, кто прошел экзамен (1-2 монеты), мы просим DeepSeek сделать прогноз на будущее (Снайперская линия).

Итог:
В категорию AI попадают только те монеты, которые:

    Нельзя обрушить (защита от китов).
    Ведут себя логично (DeepSeek их понимает и уже доказал это на истории 5 минут назад).

В категорию FT попадают все остальные нормальные монеты, которые просто находятся в зоне перепроданности (LONG) или перекупленности (SHORT), но DeepSeek за них не ручается.

