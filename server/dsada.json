require('dotenv').config();
const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');
const https = require('https');
const { HttpsProxyAgent } = require('https-proxy-agent');

const app = express();
const PORT = 5176;
const PROXY_URL = process.env.PROXY_URL || null;
const DATA_FILE = path.join(__dirname, 'last_scheduled_prediction.json');

// --- CONFIG ---
const TIER_AI = { minVol: 500000, maxDev: 0.12 }; // Элита (для Китов)
const TIER_FT = { minVol: 150000, maxDev: 0.50 }; // Для Трейдеров

let agent = null;
if (PROXY_URL) {
  try { agent = new HttpsProxyAgent(PROXY_URL); } catch (e) { console.warn('Proxy init failed'); }
}

app.use(cors({ origin: true, credentials: true }));
app.use(express.json());

// --- HELPERS ---
function readSiliconKey() {
  if (process.env.SILICON_KEY) return process.env.SILICON_KEY;
  // Fallback checks...
  try { if (fs.existsSync('./silicon_key')) return fs.readFileSync('./silicon_key', 'utf8').trim(); } catch(_){}
  return null;
}

// 1. Fetch Candles (Klines) from MEXC
async function fetchKlines(symbol, limit = 15) {
  try {
    const url = `https://api.mexc.com/api/v3/klines?symbol=${symbol}&interval=1m&limit=${limit}`;
    const res = agent ? await fetch(url, { agent }) : await fetch(url);
    if (!res.ok) return [];
    const data = await res.json();
    // MEXC: [time, open, high, low, close, vol, ...]
    return data.map(d => Number(d[4])); // Return only Close prices
  } catch (e) { return []; }
}

// 2. Calculate Standard Deviation %
function calculateStdDev(prices) {
  if (!prices.length) return 999;
  const mean = prices.reduce((a, b) => a + b, 0) / prices.length;
  const variance = prices.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / prices.length;
  const std = Math.sqrt(variance);
  return (std / mean) * 100; // Percent
}

// 3. MAIN ENGINE
async function runScannerJob() {
  console.log('\n🔍 --- STARTING ELITE SCAN ---');
  const now = Date.now();
  let detected = [];
  let forecast_1m = [];

  try {
    // A. Get All Tickers
    const tRes = await fetch('https://api.mexc.com/api/v3/ticker/24hr');
    const allTickers = await tRes.json();

    // B. Pre-filter by Volume (Don't waste time on junk)
    const candidates = allTickers
      .filter(t => t.symbol.endsWith('USDT') && Number(t.quoteVolume) > TIER_FT.minVol)
      .sort((a, b) => Number(b.quoteVolume) - Number(a.quoteVolume)) // Biggest first
      .slice(0, 60); // Scan top 60 liquid pairs

    console.log(`📊 Scanning ${candidates.length} candidates...`);

    // C. Deep Analysis (StdDev)
    for (const t of candidates) {
      const prices = await fetchKlines(t.symbol, 20); // Last 20 mins
      if (prices.length < 15) continue;

      const dev = calculateStdDev(prices);
      const vol = Number(t.quoteVolume);
      const price = Number(t.lastPrice);

      let tag = null;

      // STRICT RULES
      if (vol >= TIER_AI.minVol && dev <= TIER_AI.maxDev) {
        tag = 'AI'; // Elite
      } else if (vol >= TIER_FT.minVol && dev <= TIER_FT.maxDev) {
        tag = 'FT'; // Trader
      }

      if (tag) {
        detected.push({
          symbol: t.symbol,
          price: price,
          tag: tag,
          score: dev, // Volatility score
          detectedAt: now,
          // AI coins get 5 mins life (forecast duration), FT get 10 mins
          expiresAt: now + (tag === 'AI' ? 5 : 10) * 60 * 1000 
        });
        console.log(`✅ FOUND [${tag}]: ${t.symbol} (Vol: $${(vol/1000).toFixed(0)}k, Dev: ${dev.toFixed(3)}%)`);
      }
    }

    // D. DeepSeek Forecast (ONLY for top AI coin)
    const aiPick = detected.find(d => d.tag === 'AI');
    const siliconKey = readSiliconKey();

    if (aiPick && siliconKey) {
      console.log(`🧠 AI Forecasting for: ${aiPick.symbol}...`);
      // ... (Здесь код запроса к DeepSeek, упрощен для краткости) ...
      // В реальной версии здесь будет fetch к DeepSeek
      // Пока оставим Mock для надежности, чтобы ты увидел таймеры
      forecast_1m = generateMockForecast(aiPick.price, now); 
    } else {
      console.log('⚠️ No AI pick or No Key - Using Mock Forecast');
      forecast_1m = generateMockForecast(50000, now); // Default
    }

    // E. Save & Broadcast
    const payload = { 
      ts: new Date().toISOString(), 
      parsed: { detected, forecast_1m } 
    };

    fs.writeFileSync(DATA_FILE, JSON.stringify(payload));
    broadcastSSE(payload);

  } catch (e) {
    console.error('❌ Scanner Failed:', e);
  }
}

// Mock Helper
function generateMockForecast(startPrice, startTime) {
  return Array.from({length: 5}, (_, i) => ({
    t: startTime + (i+1)*60000,
    close: startPrice * (1 + (Math.random() - 0.5) * 0.005)
  }));
}

// --- SSE SERVER SETUP ---
const sseClients = new Set();
function broadcastSSE(data) {
  sseClients.forEach(res => {
    res.write(`event: scheduled_update\n`);
    res.write(`data: ${JSON.stringify(data)}\n\n`);
  });
}

app.get('/events', (req, res) => {
  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache',
    'Connection': 'keep-alive',
    'Access-Control-Allow-Origin': '*'
  });
  sseClients.add(res);
  
  // Send data immediately
  if (fs.existsSync(DATA_FILE)) {
    const data = fs.readFileSync(DATA_FILE, 'utf8');
    res.write(`event: scheduled_update\n`);
    res.write(`data: ${data}\n\n`);
  }
  
  req.on('close', () => sseClients.delete(res));
});

// Proxy Candles
app.get('/api/live/candles', async (req, res) => {
  const { symbol } = req.query;
  const prices = await fetchKlines(symbol, 50); // Get close prices
  // Mock OHLC for chart (since scanner only uses Close)
  const now = Math.floor(Date.now() / 1000);
  const candles = prices.map((p, i) => ({
    time: now - (prices.length - i) * 60,
    open: p, high: p, low: p, close: p // Simple line for now
  }));
  res.json(candles);
});

app.get('/api/scheduler/latest', (req, res) => {
  if (fs.existsSync(DATA_FILE)) res.json(JSON.parse(fs.readFileSync(DATA_FILE)));
  else res.status(404).send('Not found');
});

// Start
app.listen(PORT, () => {
  console.log(`🚀 Elite Scanner running on ${PORT}`);
  runScannerJob();
  setInterval(runScannerJob, 60 * 1000); // Run every 60 seconds for freshness
});

