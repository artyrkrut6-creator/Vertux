import React, { useEffect, useRef, useState } from 'react';
import { createChart, IChartApi, LineStyle, CandlestickData, LineData, ISeriesApi, ColorType } from 'lightweight-charts';

interface Props {
symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = '—' }) => {
const ref = useRef<HTMLDivElement | null>(null);
const chartRef = useRef<IChartApi | null>(null);
const resizeObserverRef = useRef<ResizeObserver | null>(null);
const candlestickSeriesRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
const forecastSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);

const [candles, setCandles] = useState<CandlestickData[]>([]);
const [forecast, setForecast] = useState<LineData[]>([]);

// Fetch historical candles
useEffect(() => {
if (!symbol || symbol.includes('—') || symbol.includes('-') || symbol.length < 4) {
setCandles([]);
return;
}
const fetchCandles = async () => {
try {
const response = await fetch(/api/live/candles?symbol=${symbol}&limit=50);
if (!response.ok) throw new Error('Failed to fetch candles');
const data = await response.json();
const formatted: CandlestickData[] = data.map((c: any) => ({
time: Math.floor(c.time), // assuming time is in seconds
open: c.open,
high: c.high,
low: c.low,
close: c.close,
}));
setCandles(formatted);
} catch (error) {
console.error('Error fetching candles:', error);
setCandles([]);
}
};
fetchCandles();
}, [symbol]);

// Fetch forecast data
useEffect(() => {
const fetchForecast = async () => {
try {
const response = await fetch('/api/scheduler/latest');
if (!response.ok) throw new Error('Failed to fetch forecast');
const data = await response.json();
const parsed = data.parsed || data;
if (parsed.forecast_1m && Array.isArray(parsed.forecast_1m)) {
const formatted: LineData[] = parsed.forecast_1m.map((f: any) => ({
time: Math.floor(f.t / 1000), // convert ms to seconds
value: f.close,
}));
setForecast(formatted);
} else {
setForecast([]);
}
} catch (error) {
console.error('Error fetching forecast:', error);
setForecast([]);
}
};
fetchForecast();
}, []);

// Create chart and series once
useEffect(() => {
if (!ref.current) return;
const chart = createChart(ref.current, {
width: ref.current.clientWidth || 800,
height: 400,
layout: {
background: { type: ColorType.Solid, color: 'transparent' },
textColor: '#9ca3af',
},
grid: {
vertLines: { color: 'rgba(255, 255, 255, 0.05)' },
horzLines: { color: 'rgba(255, 255, 255, 0.05)' },
},
crosshair: {
horzLine: { color: '#8b5cf6', style: LineStyle.Dashed },
vertLine: { color: '#8b5cf6', style: LineStyle.Dashed },
},
});
chartRef.current = chart;

text

// Add series
const candlestickSeries = chart.addCandlestickSeries({
  upColor: '#22c55e',
  downColor: '#ef4444',
  wickUpColor: '#22c55e',
  wickDownColor: '#ef4444',
});
candlestickSeriesRef.current = candlestickSeries;

const forecastSeries = chart.addLineSeries({
  color: '#8b5cf6',
  lineStyle: LineStyle.Dashed,
  lineWidth: 2,
});
forecastSeriesRef.current = forecastSeries;

// Resize observer
const resizeObserver = new ResizeObserver(() => {
  if (chartRef.current && ref.current) {
    chartRef.current.applyOptions({
      width: ref.current.clientWidth,
      height: ref.current.clientHeight,
    });
  }
});
resizeObserver.observe(ref.current);
resizeObserverRef.current = resizeObserver;

return () => {
  resizeObserver.disconnect();
  if (candlestickSeriesRef.current) chart.removeSeries(candlestickSeriesRef.current);
  if (forecastSeriesRef.current) chart.removeSeries(forecastSeriesRef.current);
  chart.remove();
  chartRef.current = null;
  candlestickSeriesRef.current = null;
  forecastSeriesRef.current = null;
};

}, []);

// Update candlestick data
useEffect(() => {
if (candlestickSeriesRef.current) {
candlestickSeriesRef.current.setData(candles);
if (chartRef.current) chartRef.current.timeScale().fitContent();
}
}, [candles]);

// Update forecast data
useEffect(() => {
if (forecastSeriesRef.current) {
forecastSeriesRef.current.setData(forecast);
if (chartRef.current) chartRef.current.timeScale().fitContent();
}
}, [forecast]);

return (
<div className="w-full h-full drop-shadow-[0_0_10px_rgba(139,92,246,0.5)]">
<div ref={ref} className="w-full h-full" />
</div>
);
};

export default ChartContainer;
The ChartContainer.tsx has been optimized as requested. Key changes:

Strong Guard Clause: Enhanced the fetch logic to skip invalid symbols (undefined, null, containing "—" or "-", or length < 4), setting candles to an empty array to prevent 500 errors.
Fixed Flickering: Chart and series are now initialized only once. Data updates use setData() on existing series refs, avoiding dynamic removal/addition.
Visuals: Background uses ColorType.Solid for proper transparency. ResizeObserver handles resizing.
The full updated code is provided above. Test by refreshing the app and selecting a valid symbol (e.g., BTCUSDT) to confirm no crashes and smooth chart updates.
