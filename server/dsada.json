                    <div className="mt-1 flex items-center gap-3 text-xs font-mono text-gray-300">
                      <span className="flex items-center gap-1 text-gray-400">
                        <BarChart3 className="w-3 h-3" />
                        Vol24h
                      </span>
                      <span>${fmtVol(c.quoteVolume)}</span>

                      <span className="text-gray-500">•</span>

                      <span className="text-gray-400">StdDev</span>
                      <span>{Number.isFinite(c.stdDev) ? `${c.stdDev.toFixed(3)}%` : '--'}</span>
                    </div>
                  </div>

                  {/* RIGHT */}
                  <div className="flex flex-col items-end gap-2">
                    {isAI && (
                      <Flame className="w-5 h-5 text-violet-300 animate-pulse drop-shadow-[0_0_10px_rgba(139,92,246,0.8)]" />
                    )}

                    {isAI && (
                      <div className="flex items-center gap-1 text-xs font-mono text-cyan-300">
                        <Clock className="w-3 h-3" />
                        {fmtMMSS(timeLeft)}
                      </div>
                    )}
                  </div>
                </div>

                {/* Progress bar only for AI */}
                {isAI && (
                  <div className="mt-2 h-[2px] w-full bg-white/10 rounded">
                    <div
                      className="h-full bg-violet-400 rounded"
                      style={{ width: `${pct}%`, transition: 'width 1s linear' }}
                    />
                  </div>
                )}
              </div>
            );
          })}

          {sorted.length === 0 && (
            <div className="p-6 text-center text-sm text-gray-500">
              Сканирую рынок… ожидаю сигналы
            </div>
          )}
        </div>
      </div>
    </aside>
  );
};

export default Sidebar;

