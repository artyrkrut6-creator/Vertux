import { create } from 'zustand';

// Интерфейс монеты из PROMPT 1
export interface DetectedCoin {
  symbol: string;
  price: number;
  stdDev: number;      // Стандартное отклонение
  detectedAt: number;  // Timestamp обнаружения
  expiresAt: number;   // Время истечения (detectedAt + 5 мин)
}

interface ScannerState {
  coins: DetectedCoin[];
  addDetectedCoin: (coin: DetectedCoin) => void;
  removeExpiredCoins: () => void;
}

export const useScannerStore = create<ScannerState>((set, get) => ({
  coins: [],

  addDetectedCoin: (newCoin) => {
    set((state) => {
      // Проверяем, есть ли уже эта монета, чтобы обновить, а не дублировать
      const exists = state.coins.find((c) => c.symbol === newCoin.symbol);
      
      if (exists) {
        // Обновляем существующую
        return {
          coins: state.coins.map((c) => 
            c.symbol === newCoin.symbol ? { ...newCoin } : c
          )
        };
      }
      
      // Добавляем новую в начало списка
      return { coins: [newCoin, ...state.coins] };
    });
  },

  removeExpiredCoins: () => {
    const now = Date.now();
    set((state) => ({
      coins: state.coins.filter((c) => c.expiresAt > now),
    }));
  },
}));

// Запускаем таймер очистки устаревших монет (Watchdog из промпта)
// Проверяем каждую секунду
setInterval(() => {
  useScannerStore.getState().removeExpiredCoins();
}, 1000);

