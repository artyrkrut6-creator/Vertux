ROLE: Senior Frontend/Animation Engineer.
GOAL: Create a cinematic "Fullscreen Mode" for the Chart.
When the user clicks "Maximize", the Sidebar should smoothly slide out (animate width to 0), and the Chart should fluidly expand to fill the screen.

**TASK: Rewrite `src/components/Layout.tsx` using `framer-motion` layout animations.**

**DESIGN SPECS:**
1.  **Sidebar Animation:**
    - Use `<AnimatePresence>` + `<motion.div>`.
    - Animate `width`, `opacity`, and `x` position.
    - Easing: `[0.4, 0, 0.2, 1]` (Material Design Curve).

2.  **Chart Expansion:**
    - Wrap the main content in `<motion.main layout>`.
    - When Sidebar hides, this container automatically animates its size to fill the gap.

3.  **Header Controls:**
    - **Left:** "Expand/Collapse" Button (Icon: `Maximize2` / `Minimize2`).
      - Style: Glassmorphism button.
    - **Right:** "TRADE ON MEXC" Button.
      - Style: Gradient Violet/Blue, glowing shadow.

4.  **Mobile Logic:**
    - On mobile, `isFullscreen` effectively toggles between "List View" and "Chart View".
    - When a coin is selected in List -> auto-switch to Fullscreen Chart.
    - Chart has a "Back to List" button on mobile.

**CODE TO IMPLEMENT (`src/components/Layout.tsx`):**

```tsx
import React, { useEffect, useState, useMemo } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Maximize2, Minimize2, ExternalLink, ChevronLeft, LayoutPanelLeft } from 'lucide-react';
import Sidebar from './Sidebar';
import ChartContainer from './ChartContainer';
import SmartSearchButton from './SmartSearchButton';
import useScannerStore, { DetectedCoin } from '../store/scannerStore';
import mexcService from '../services/mexcService';

export const Layout: React.FC = () => {
  const [selected, setSelected] = useState<string | undefined>(undefined);
  const [isFullscreen, setIsFullscreen] = useState(false);
  const [isMobile, setIsMobile] = useState(false);

  // Background scanner hook (disabled, server handles it)
  // useMarketScanner({ enabled: false });
  
  const coins = useScannerStore((s) => s.coins || []);
  const addDetectedCoin = useScannerStore((s) => s.addDetectedCoin);

  // Responsive check
  useEffect(() => {
    const checkMobile = () => setIsMobile(window.innerWidth < 768);
    checkMobile();
    window.addEventListener('resize', checkMobile);
    return () => window.removeEventListener('resize', checkMobile);
  }, []);

  // ... (Keep existing SSE / Initial Fetch logic here) ...
  // Paste the 'useEffect' for SSE/Data parsing from previous steps here.
  // ...

  const handleSelect = (s: string) => {
    setSelected(s);
    if (isMobile) setIsFullscreen(true); // Auto-open chart on mobile
  };

  const tradeLink = `https://www.mexc.com/exchange/${(selected || 'BTCUSDT').replace('USDT', '_USDT')}`;

  return (
    <div className="min-h-screen bg-[#050505] text-white overflow-hidden flex flex-col font-sans selection:bg-violet-500/30">
      
      {/* BACKGROUND AMBIENCE */}
      <div className="fixed inset-0 pointer-events-none z-0">
         <div className="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-violet-900/10 blur-[120px] rounded-full" />
         <div className="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-900/10 blur-[120px] rounded-full" />
      </div>

      <div className="flex-1 flex w-full h-full relative z-10 p-2 gap-2">
        
        {/* SIDEBAR CONTAINER */}
        <AnimatePresence mode="popLayout">
          {(!isFullscreen || !isMobile) && !isFullscreen && (
            <motion.aside
              initial={{ width: 0, opacity: 0, x: -20 }}
              animate={{ width: isMobile ? '100%' : 360, opacity: 1, x: 0 }}
              exit={{ width: 0, opacity: 0, x: -20 }}
              transition={{ type: "spring", stiffness: 300, damping: 30 }}
              className={`h-full ${isMobile ? 'w-full absolute inset-0 z-50 bg-[#050505]' : 'relative'}`}
            >
               <Sidebar onSelect={handleSelect} selected={selected} />
            </motion.aside>
          )}
        </AnimatePresence>

        {/* MAIN CONTENT (Chart) */}
        <motion.main 
          layout
          className="flex-1 flex flex-col h-full min-w-0 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-xl shadow-2xl relative overflow-hidden"
        >
          {/* HEADER */}
          <div className="h-14 border-b border-white/5 flex items-center justify-between px-4 bg-black/20">
             
             {/* LEFT CONTROLS */}
             <div className="flex items-center gap-2">
                {/* Mobile Back Button */}
                {isMobile && (
                  <button 
                    onClick={() => setIsFullscreen(false)}
                    className="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-400"
                  >
                    <ChevronLeft size={20} />
                  </button>
                )}

                {/* Desktop Toggle Sidebar */}
                {!isMobile && (
                  <button 
                    onClick={() => setIsFullscreen(!isFullscreen)}
                    className="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/5 transition-all group"
                  >
                    {isFullscreen ? <LayoutPanelLeft size={16} className="text-violet-400 group-hover:scale-110 transition-transform"/> : <Maximize2 size={16} className="text-gray-400"/>}
                    <span className="text-xs font-bold text-gray-300">
                      {isFullscreen ? 'SHOW LIST' : 'EXPAND'}
                    </span>
                  </button>
                )}

                {/* Coin Info */}
                <div className="h-6 w-[1px] bg-white/10 mx-2" />
                <span className="font-bold text-lg tracking-tight text-white/90">
                  {selected || 'BTCUSDT'}
                </span>
             </div>

             {/* RIGHT CONTROLS (Trade Button) */}
             <a 
               href={tradeLink}
               target="_blank" 
               rel="noopener noreferrer"
               className="flex items-center gap-2 px-4 py-1.5 bg-gradient-to-r from-violet-600 to-indigo-600 rounded-lg shadow-lg shadow-violet-500/20 hover:shadow-violet-500/40 hover:scale-105 active:scale-95 transition-all group"
             >
               <span className="text-xs font-bold tracking-wide">TRADE</span>
               <ExternalLink size={14} className="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
             </a>

          </div>

          {/* CHART AREA */}
          <div className="flex-1 relative w-full h-full">
             <ChartContainer symbol={selected ?? 'BTCUSDT'} />
          </div>

        </motion.main>

      </div>
      
      {/* Floating Action Button (Only visible when list is visible) */}
      {!isFullscreen && <SmartSearchButton onSelect={handleSelect} />}
    </div>
  );
};

export default Layout;

