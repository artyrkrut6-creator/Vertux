// Additionally request variation and realistic min/max ranges: ask the model NOT to repeat identical close values,
// and to ensure the forecast exhibits reasonable minute-to-minute variation. This increases chance of informative output.
const system = `You are Deepsik, a crypto market analyst. Output ONLY a single JSON object with keys: "analysis" (short string) and "forecast_1m" (array of exactly 10 candle objects). Each candle object MUST have: "offset_minutes": integer (1 for next 1-minute candle, 2 for two minutes ahead, etc.), and numeric fields "open", "high", "low", "close" representing absolute prices. Do NOT repeat the same numeric close for all candles. Ensure the forecast shows realistic minute-by-minute variation (small fluctuations are fine). Do NOT include absolute timestamps. Output no explanations, no markdown, only the JSON object.`
const user = `Analyze these candles:\n${payloadText}\nProvide the forecast as described above (forecast_1m with 10 candles using offset_minutes). Do NOT repeat identical close values for every candle; include small realistic variation. Output the JSON object only.`

// Ensemble & retry settings (tweakable)
const ENSEMBLE_RUNS = Number(process.env.ENSEMBLE_RUNS || 5)
const MAX_ATTEMPTS = Number(process.env.MAX_ATTEMPTS || 3)
const MIN_REL_RANGE = Number(process.env.MIN_REL_RANGE || 0.0002) // relative (max-min)/mean required to consider forecast non-flat

console.log(`📡 Calling DeepSeek (ensemble x${ENSEMBLE_RUNS}, up to ${MAX_ATTEMPTS} attempts if flat)...`)
const siliconKey = readSiliconKey()
let parsed = null
if (!siliconKey) {
