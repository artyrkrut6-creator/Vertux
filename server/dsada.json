React

import React, { useEffect, useRef, useState } from 'react';
import {
  createChart,
  IChartApi,
  LineStyle,
  CandlestickData,
  LineData,
  ISeriesApi,
  ColorType,
} from 'lightweight-charts';

interface Props {
  symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = '—' }) => {
  const ref = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const resizeObserverRef = useRef<ResizeObserver | null>(null);
  
  const candlestickSeriesRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const forecastSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);

  const [candles, setCandles] = useState<CandlestickData[]>([]);
  const [forecast, setForecast] = useState<LineData[]>([]);

  // 1. Fetch historical candles (Real Data)
  useEffect(() => {
    if (!symbol || symbol.includes('—') || symbol.includes('-') || symbol.length < 4) {
      setCandles([]);
      return;
    }
    
    let cancelled = false;
    
    const fetchCandles = async () => {
      try {
        const response = await fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol)}&limit=50`);
        if (!response.ok) throw new Error('Failed to fetch candles');
        
        const data = await response.json();
        const formatted: CandlestickData[] = Array.isArray(data)
          ? data.map((c: any) => ({
              time: Math.floor(c.time),
              open: Number(c.open),
              high: Number(c.high),
              low: Number(c.low),
              close: Number(c.close),
            })).sort((a, b) => (a.time as number) - (b.time as number))
          : [];
          
        if (!cancelled) setCandles(formatted);
      } catch (error) {
        console.error('Error fetching candles:', error);
        if (!cancelled) setCandles([]);
      }
    };
    
    fetchCandles();
    
    return () => { cancelled = true; };
  }, [symbol]);

  // 2. Fetch forecast data (AI Pattern)
  useEffect(() => {
    let cancelled = false;
    
    const fetchForecast = async () => {
      try {
        const response = await fetch('/api/scheduler/latest');
        if (!response.ok) throw new Error('Failed to fetch forecast');
        
        const data = await response.json();
        const parsed = data.parsed || data;
        
        if (parsed.forecast_1m && Array.isArray(parsed.forecast_1m)) {
          const formatted: LineData[] = parsed.forecast_1m.map((f: any) => ({
            time: Math.floor(Number(f.t) / 1000), 
            value: Number(f.close),
          })).sort((a: any, b: any) => a.time - b.time);
          
          if (!cancelled) setForecast(formatted);
        } else {
          if (!cancelled) setForecast([]);
        }
      } catch (error) {
        console.error('Error fetching forecast:', error);
        if (!cancelled) setForecast([]);
      }
    };
    
    fetchForecast();
    
    return () => { cancelled = true; };
  }, []); // Run once on mount to get the latest pattern

  // 3. Initialize Chart
  useEffect(() => {
    if (!ref.current) return;
    
    const chart = createChart(ref.current, {
      width: ref.current.clientWidth || 800,
      height: 400,
      layout: {
        background: { type: ColorType.Solid, color: 'transparent' },
        textColor: '#9ca3af',
      },
      grid: {
        vertLines: { color: 'rgba(255, 255, 255, 0.05)' },
        horzLines: { color: 'rgba(255, 255, 255, 0.05)' },
      },
      crosshair: {
        horzLine: { color: '#8b5cf6', style: LineStyle.Dashed },
        vertLine: { color: '#8b5cf6', style: LineStyle.Dashed },
      },
      timeScale: {
        timeVisible: true,
        secondsVisible: false,
      }
    });
    
    chartRef.current = chart;

    const candlestickSeries = chart.addCandlestickSeries({
      upColor: '#22c55e',
      downColor: '#ef4444',
      wickUpColor: '#22c55e',
      wickDownColor: '#ef4444',
    });
    candlestickSeriesRef.current = candlestickSeries;

    const forecastSeries = chart.addLineSeries({
      color: '#8b5cf6',
      lineStyle: LineStyle.Dashed,
      lineWidth: 2,
      crosshairMarkerVisible: true,
    });
    forecastSeriesRef.current = forecastSeries;

    const resizeObserver = new ResizeObserver(() => {
      if (chartRef.current && ref.current) {
        chartRef.current.applyOptions({
          width: ref.current.clientWidth,
          height: ref.current.clientHeight,
        });
      }
    });
    
    resizeObserver.observe(ref.current);
    resizeObserverRef.current = resizeObserver;

    return () => {
      resizeObserver.disconnect();
      chart.remove();
      chartRef.current = null;
    };
  }, []);

  // 4. Update Candles
  useEffect(() => {
    if (candlestickSeriesRef.current && candles.length > 0) {
      candlestickSeriesRef.current.setData(candles);
      if (chartRef.current) chartRef.current.timeScale().fitContent();
    }
  }, [candles]);

  // 5. SMART SCALING: Map Forecast to Current Price
  useEffect(() => {
    if (!forecastSeriesRef.current || !chartRef.current) return;

    // Wait until we have both real data and forecast data
    if (candles.length === 0 || forecast.length === 0) {
      // Clean up if missing data
      forecastSeriesRef.current.setData([]); 
      return;
    }

    try {
      const lastRealCandle = candles[candles.length - 1];
      const lastRealPrice = Number(lastRealCandle.close);
      const lastRealTime = Number(lastRealCandle.time); 

      // Take the first point of the forecast to calculate the "shape" ratio
      const firstForecastVal = Number(forecast[0].value);
      
      // Safety check to avoid division by zero
      if (!firstForecastVal) return;

      const mappedForecast: LineData[] = forecast.map((f, i) => {
        // Calculate relative move: e.g. 1.05 (5% up) or 0.95 (5% down)
        const ratio = Number(f.value) / firstForecastVal;
        
        // Apply this move to the ACTUAL current price
        const adjustedPrice = lastRealPrice * ratio;

        return {
          // Start 1 minute after the last real candle
          time: lastRealTime + (i + 1) * 60, 
          value: adjustedPrice
        };
      });

      forecastSeriesRef.current.setData(mappedForecast);
      chartRef.current.timeScale().fitContent();
      
    } catch (e) {
      console.error("Error scaling forecast:", e);
    }

  }, [forecast, candles]); // Re-run whenever we get new candles or new forecast

  return (
    <div className="w-full h-full drop-shadow-[0_0_10px_rgba(139,92,246,0.5)]">
      <div ref={ref} className="w-full h-full" />
    </div>
  );
};

export default ChartContainer;

