import React, { useEffect, useRef, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { createChart, IChartApi, LineStyle, ColorType, CandlestickData, ISeriesApi, IPriceLine } from 'lightweight-charts';
import { AdvancedRealTimeChart } from 'react-ts-tradingview-widgets';
import confetti from 'canvas-confetti';

interface Props { symbol?: string; }

const ChartContainer: React.FC<Props> = ({ symbol = 'BTCUSDT' }) => {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const candleRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const targetLineRef = useRef<IPriceLine | null>(null);
  const stopLossLineRef = useRef<IPriceLine | null>(null);

  const [candles, setCandles] = useState<CandlestickData[]>([]);
  const [forecastPack, setForecastPack] = useState<any>(null);
  const [viewMode, setViewMode] = useState<'AI' | 'TV'>('AI');
  const [winStatus, setWinStatus] = useState<'WON' | 'LOST' | null>(null);

  // Clear
  useEffect(() => {
    if (candleRef.current) candleRef.current.setData([]);
    setWinStatus(null);
  }, [symbol]);

  // Fetch Logic
  useEffect(() => {
    fetch(`/api/live/candles?symbol=${symbol}&limit=120`).then(r=>r.json()).then(d => {
        const f = d.map((c: any) => ({time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close)})).sort((a:any,b:any)=>a.time-b.time);
        setCandles(f);
    });
    fetch('/api/scheduler/latest').then(r=>r.json()).then(j => {
        const pack = (j?.parsed || j)?.forecastsBySymbol?.[String(symbol).toUpperCase()];
        if (pack && pack.source === 'deepseek') setForecastPack(pack); else setForecastPack(null);
    });
  }, [symbol]);

  // Chart Init
  useEffect(() => {
    if (!containerRef.current) return;
    const chart = createChart(containerRef.current, { width: containerRef.current.clientWidth, height: 420, layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: '#9ca3af' }, grid: { vertLines: { color: 'rgba(255,255,255,0.05)' }, horzLines: { color: 'rgba(255,255,255,0.05)' } } });
    chartRef.current = chart;
    candleRef.current = chart.addCandlestickSeries();
    const ro = new ResizeObserver(() => chart.applyOptions({ width: containerRef.current?.clientWidth, height: containerRef.current?.clientHeight }));
    ro.observe(containerRef.current);
    return () => { ro.disconnect(); chart.remove(); };
  }, []);

  // Render & Logic
  useEffect(() => {
    if (!candleRef.current) return;
    if (candles.length) candleRef.current.setData(candles);

    if (forecastPack) {
        if (forecastPack.target_price) targetLineRef.current = candleRef.current.createPriceLine({ price: parseFloat(forecastPack.target_price), color: '#00ff00', lineWidth: 3, title: 'TARGET' } as any);
        if (forecastPack.stop_loss_price) stopLossLineRef.current = candleRef.current.createPriceLine({ price: parseFloat(forecastPack.stop_loss_price), color: '#ff0000', lineWidth: 2, lineStyle: LineStyle.Dotted, title: 'STOP' } as any);
        
        // Server Status Check
        if (forecastPack.status === 'WON') { setWinStatus('WON'); confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } }); }
        if (forecastPack.status === 'LOST') setWinStatus('LOST');
    }
  }, [candles, forecastPack]);

  // Live Stream & Client Check
  useEffect(() => {
    const es = new EventSource(`/api/live/stream?symbol=${symbol}`);
    es.addEventListener('candle_update', (ev) => {
        const c = JSON.parse(ev.data);
        if (candleRef.current) candleRef.current.update({ time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close) });
        
        // Client-side Win check (immediate feedback)
        if (forecastPack && !winStatus) {
            const p = Number(c.close);
            const tp = Number(forecastPack.target_price);
            const sl = Number(forecastPack.stop_loss_price);
            if (forecastPack.direction === 'LONG' && p >= tp) { setWinStatus('WON'); confetti(); }
            if (forecastPack.direction === 'LONG' && p <= sl) setWinStatus('LOST');
        }
    });
    return () => es.close();
  }, [symbol, forecastPack, winStatus]);

  return (
    <div className="w-full h-full relative">
      <div style={{position:'absolute', top: 10, right: 10, zIndex: 50}}>
        <button onClick={()=>setViewMode('AI')} className="bg-gray-800 text-white px-2 py-1 text-xs rounded mr-2">AI</button>
        <button onClick={()=>setViewMode('TV')} className="bg-gray-800 text-white px-2 py-1 text-xs rounded">TV</button>
      </div>

      {viewMode === 'AI' ? (
        <div ref={containerRef} className="w-full h-full" />
      ) : (
        <AdvancedRealTimeChart theme="dark" autosize symbol={`MEXC:${symbol}`} container_id="tv_chart" />
      )}

      {/* WIN/LOSS OVERLAY */}
      <AnimatePresence>
        {winStatus === 'WON' && (
            <motion.div initial={{opacity:0, scale:0.5}} animate={{opacity:1, scale:1}} className="absolute inset-0 flex items-center justify-center bg-green-500/20 backdrop-blur-sm z-40 pointer-events-none">
                <h1 className="text-6xl font-black text-white drop-shadow-[0_0_20px_#4ade80]">TARGET HIT 🎯</h1>
            </motion.div>
        )}
        {winStatus === 'LOST' && (
            <motion.div initial={{opacity:0}} animate={{opacity:1}} className="absolute inset-0 flex items-center justify-center bg-red-500/20 backdrop-blur-sm z-40 pointer-events-none">
                <h1 className="text-6xl font-black text-white drop-shadow-[0_0_20px_#ef4444]">STOPPED OUT 🛑</h1>
            </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
};

export default ChartContainer;

