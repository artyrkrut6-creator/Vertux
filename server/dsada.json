Проблема в том, что в прошлом коде отрисовка линий (TP/SL) была "зашита" внутрь анимации свечей.
Если данные о прогнозе (forecastPack) приходили на долю секунды позже, чем данные свечей, анимация заканчивалась, проверяла прогноз (которого еще не было в стейте) и ничего не рисовала.

Решение:
Я вынес отрисовку линий в отдельный, независимый процесс.

    Свечи строятся анимацией.
    Как только анимация закончилась И данные прогноза есть — линии рисуются мгновенно.

Вот исправленный, железобетонный код src/components/ChartContainer.tsx.
Инструкция:

    Ctrl+A -> Delete (в файле ChartContainer.tsx).
    Вставь этот код.

React

import React, { useEffect, useRef, useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  createChart,
  IChartApi,
  LineStyle,
  ColorType,
  CandlestickData,
  ISeriesApi,
  IPriceLine
} from 'lightweight-charts';
import { AdvancedRealTimeChart } from 'react-ts-tradingview-widgets';

interface Props {
  symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = 'BTCUSDT' }) => {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const candleRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  
  // Refs for lines to manage them manually
  const targetLineRef = useRef<IPriceLine | null>(null);
  const stopLossLineRef = useRef<IPriceLine | null>(null);

  const [fullData, setFullData] = useState<CandlestickData[]>([]);
  const [forecastPack, setForecastPack] = useState<any>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [isBuilding, setIsBuilding] = useState(false);
  const [viewMode, setViewMode] = useState<'AI' | 'TV'>('AI');

  // 1. Reset everything on Symbol Change
  useEffect(() => {
    setIsLoading(true);
    setIsBuilding(false);
    setForecastPack(null); // Clear old forecast immediately
    
    if (candleRef.current) candleRef.current.setData([]);
    
    // Safely remove old lines
    if (candleRef.current) {
        if (targetLineRef.current) { try { candleRef.current.removePriceLine(targetLineRef.current); } catch(e){} targetLineRef.current = null; }
        if (stopLossLineRef.current) { try { candleRef.current.removePriceLine(stopLossLineRef.current); } catch(e){} stopLossLineRef.current = null; }
    }
  }, [symbol]);

  // 2. Fetch Data (Candles + Forecast)
  useEffect(() => {
    let active = true;
    
    // Parallel fetch
    Promise.all([
      fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol || 'BTCUSDT')}&limit=120`).then(r => r.json()),
      fetch('/api/scheduler/latest').then(r => r.json())
    ]).then(([candlesData, forecastData]) => {
      if (!active) return;

      const formatted = (Array.isArray(candlesData) ? candlesData : []).map((c: any) => ({
        time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close)
      })).sort((a: any, b: any) => a.time - b.time);

      const parsed = forecastData?.parsed || forecastData;
      const pack = parsed?.forecastsBySymbol?.[String(symbol).toUpperCase()];
      
      // Strict check for DeepSeek source
      const validPack = (pack && pack.source === 'deepseek') ? pack : null;
      
      setFullData(formatted);
      setForecastPack(validPack);
      
      if (formatted.length > 0) {
          setIsLoading(false);
          setIsBuilding(true); // Trigger build animation
      } else {
          setIsLoading(false);
      }
    }).catch(() => setIsLoading(false));

    return () => { active = false; };
  }, [symbol]);

  // 3. Init Chart
  useEffect(() => {
    if (!containerRef.current) return;
    const chart = createChart(containerRef.current, {
      width: containerRef.current.clientWidth,
      height: containerRef.current.clientHeight,
      layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: '#9ca3af' },
      grid: { vertLines: { color: 'rgba(255,255,255,0.02)' }, horzLines: { color: 'rgba(255,255,255,0.02)' } },
      timeScale: { timeVisible: true, secondsVisible: false },
      rightPriceScale: { borderVisible: false },
      crosshair: { vertLine: { color: '#8b5cf6', style: LineStyle.Dashed }, horzLine: { color: '#8b5cf6', style: LineStyle.Dashed } }
    });
    
    chartRef.current = chart;
    candleRef.current = chart.addCandlestickSeries({ upColor: '#22c55e', downColor: '#ef4444' });

    const ro = new ResizeObserver(() => {
      if (chartRef.current && containerRef.current) {
        chartRef.current.applyOptions({ width: containerRef.current.clientWidth, height: containerRef.current.clientHeight });
      }
    });
    ro.observe(containerRef.current);

    return () => { ro.disconnect(); chart.remove(); };
  }, []);

  // 4. ANIMATION LOOP (Only for Candles)
  useEffect(() => {
    if (!isBuilding || !fullData.length || !candleRef.current) return;

    let index = 0;
    const total = fullData.length;
    const chunkSize = Math.ceil(total / 30); // Fast build (approx 0.5s)

    const animate = () => {
        if (!candleRef.current) return;
        index += chunkSize;
        const currentSlice = fullData.slice(0, Math.min(index, total));
        candleRef.current.setData(currentSlice);

        if (index < total) {
            requestAnimationFrame(animate);
        } else {
            setIsBuilding(false); // Animation done -> Allow lines to draw
        }
    };
    requestAnimationFrame(animate);

  }, [isBuilding, fullData]);

  // 5. LINES RENDERER (Runs when animation finishes OR forecast changes)
  useEffect(() => {
    if (isLoading || isBuilding || !candleRef.current || !chartRef.current) return;

    // Clear old lines first
    if (targetLineRef.current) { try { candleRef.current.removePriceLine(targetLineRef.current); } catch(e){} targetLineRef.current = null; }
    if (stopLossLineRef.current) { try { candleRef.current.removePriceLine(stopLossLineRef.current); } catch(e){} stopLossLineRef.current = null; }

    if (forecastPack) {
        // Draw Target
        if (forecastPack.target_price) {
            targetLineRef.current = candleRef.current.createPriceLine({
                price: parseFloat(forecastPack.target_price),
                color: forecastPack.direction === 'SHORT' ? '#ef4444' : '#22c55e', // Red for Short target (down), Green for Long
                lineWidth: 3,
                lineStyle: LineStyle.Solid,
                title: `🎯 TARGET ${forecastPack.target_price}`,
                axisLabelVisible: true
            } as any);
        }
        // Draw Stop Loss
        if (forecastPack.stop_loss_price) {
            stopLossLineRef.current = candleRef.current.createPriceLine({
                price: parseFloat(forecastPack.stop_loss_price),
                color: '#ef4444', // Always red for stop loss (danger)
                lineWidth: 2,
                lineStyle: LineStyle.Dotted,
                title: `🛑 STOP ${forecastPack.stop_loss_price}`,
                axisLabelVisible: true
            } as any);
        }
    }
    
    // Fit content after drawing lines
    chartRef.current.timeScale().fitContent();

  }, [isLoading, isBuilding, forecastPack]); // Run when building finishes or pack updates

  // 6. Live Stream
  useEffect(() => {
    if (isLoading || isBuilding) return;
    const es = new EventSource(`/api/live/stream?symbol=${encodeURIComponent(symbol || 'BTCUSDT')}`);
    es.addEventListener('candle_update', (ev) => {
        try {
            const c = JSON.parse(ev.data);
            if (candleRef.current) candleRef.current.update({ time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close) });
        } catch (_) {}
    });
    return () => es.close();
  }, [symbol, isLoading, isBuilding]);

  return (
    <div className="w-full h-full relative bg-transparent group overflow-hidden">

      {/* HEADER TOGGLE */}
      <div className="absolute top-2 right-2 z-50 flex bg-black/60 backdrop-blur-md rounded-lg p-1 border border-white/10">
        <button onClick={() => setViewMode('AI')} className={`px-3 py-1 text-xs font-bold rounded transition-all ${viewMode === 'AI' ? 'bg-violet-600 text-white shadow-lg' : 'text-gray-400 hover:text-white'}`}>AI TARGETS</button>
        <button onClick={() => setViewMode('TV')} className={`px-3 py-1 text-xs font-bold rounded transition-all ${viewMode === 'TV' ? 'bg-blue-600 text-white shadow-lg' : 'text-gray-400 hover:text-white'}`}>TRADINGVIEW</button>
      </div>

      {/* AI VIEW */}
      <div style={{ display: viewMode === 'AI' ? 'block' : 'none' }} className="w-full h-full relative">
        
        {/* LOADER */}
        <AnimatePresence>
          {isLoading && (
            <motion.div
              initial={{ opacity: 1 }} exit={{ opacity: 0 }}
              className="absolute inset-0 z-50 flex items-center justify-center bg-[#050505] backdrop-blur-md"
            >
              <div className="w-full h-full relative overflow-hidden">
                <div className="absolute inset-0 bg-[linear-gradient(90deg,transparent,rgba(139,92,246,0.1),transparent)] w-1/2 h-full animate-scan" />
                <div className="absolute inset-0 grid grid-cols-8 gap-4 opacity-10">
                  {[...Array(8)].map((_, i) => <div key={i} className="border-r border-violet-500/30 h-full" />)}
                </div>
              </div>
              <div className="absolute font-mono text-xs text-violet-400 tracking-widest animate-pulse">
                INITIALIZING...
              </div>
            </motion.div>
          )}
        </AnimatePresence>

        <div ref={containerRef} className="w-full h-full" />

        {/* HUD OVERLAY */}
        {!isLoading && !isBuilding && forecastPack && (
          <motion.div 
            initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }}
            style={{ position: 'absolute', left: 12, top: 12, zIndex: 40 }}
          >
            <div style={{ background: 'rgba(0,0,0,0.7)', color: '#fff', padding: '10px 12px', borderRadius: 8, minWidth: 200, backdropFilter: 'blur(4px)', border: '1px solid rgba(255,255,255,0.1)' }}>
              <div style={{ fontSize: 16, fontWeight: 800, marginBottom: 6, color: forecastPack.direction === 'LONG' ? '#4ade80' : '#f87171' }}>
                SIGNAL: {String(forecastPack.direction || '').toUpperCase()}
              </div>
              <div style={{ fontSize: 13 }}>Target: <span style={{ color: '#4ade80', fontWeight: 700 }}>{forecastPack.target_price}</span></div>
              <div style={{ fontSize: 13 }}>Stop: <span style={{ color: '#f87171', fontWeight: 700 }}>{forecastPack.stop_loss_price}</span></div>
            </div>
          </motion.div>
        )}
      </div>

      {/* TV VIEW */}
      <div style={{ display: viewMode === 'TV' ? 'block' : 'none' }} className="w-full h-full relative z-40">
        <AdvancedRealTimeChart
          theme="dark" autosize symbol={`MEXC:${String(symbol || 'BTCUSDT').toUpperCase()}`}
          interval="1" timezone="Etc/UTC" style="1" locale="en" toolbar_bg="#000000" enable_publishing={false}
          hide_top_toolbar={false} hide_legend={false} container_id="tv_chart_container"
        />
      </div>

      <style>{`@keyframes scan { 0% { transform: translateX(-100%); } 100% { transform: translateX(200%); } } .animate-scan { animation: scan 1.5s linear infinite; }`}</style>
    </div>
  );
};

export default ChartContainer;

Что изменилось:

    Разделение логики: Анимация свечей (useEffect №4) и рисование линий (useEffect №5) разделены. Линии рисуются строго после завершения анимации.
    Зависимости: useEffect с линиями зависит от [isLoading, isBuilding, forecastPack]. Это гарантирует реакцию на появление данных.
    Очистка: Старые линии корректно удаляются перед рисованием новых.

