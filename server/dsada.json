        <div className="flex-1 overflow-y-auto p-2 space-y-2 custom-scrollbar">
          {/* Using layout prop for smooth reordering without layout shifts */}
          <motion.div layout className="space-y-2">
            <AnimatePresence mode="popLayout">
              {sorted.map((c) => {
                const isAI = c.tag === 'AI';
