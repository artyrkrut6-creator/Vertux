async function mexcFetchJSON(url) {
  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), 10000);
  try {
    const res = agent ? await fetch(url, { agent, signal: controller.signal }) : await fetch(url, { signal: controller.signal });
    clearTimeout(id);
    if (!res.ok) return null;
    return res.json();
  } catch (e) { return null; }
}

async function fetch24hrTickers() { 
    return mexcFetchJSON('https://api.mexc.com/api/v3/ticker/24hr'); 
}

async function fetchMexcKlines(symbol, interval='1m', limit=50) {
  const url = `https://api.mexc.com/api/v3/klines?symbol=${encodeURIComponent(symbol)}&interval=${interval}&limit=${limit}`;
  const data = await mexcFetchJSON(url);
  return Array.isArray(data) ? data : [];
}

async function fetchMexcDepth(symbol, limit=20) {
  const url = `https://api.mexc.com/api/v3/depth?symbol=${encodeURIComponent(symbol)}&limit=${limit}`;
  return mexcFetchJSON(url);
}

function isSaneUsdtSymbol(sym) { return /^[A-Z0-9]{2,}USDT$/.test(sym); }
function isStablecoinLike(sym) { return /USDC|USDP|TUSD|DAI|FDUSD|USD1|USDE|PAXG|EUR|GBP/.test(sym); }
function isLeveraged(sym) { return /(3L|3S|5L|5S|UP|DOWN|BULL|BEAR)USDT$/.test(sym); }
function isTokenizedStock(sym) { return /ONUSDT$/.test(sym); }

function relStdDevPct(closes) {
  if (!closes.length) return 999;
  const mean = closes.reduce((s,v)=>s+v,0)/closes.length;
  if (!mean) return 999;
  const variance = closes.reduce((s, v) => s + Math.pow(v - mean, 2), 0) / closes.length;
  return (Math.sqrt(variance) / mean) * 100;
}

function calculateRSI(closes, period=14) {
  if (closes.length < period + 1) return 50;
  let gains = 0, losses = 0;
  for (let i = 1; i <= period; i++) {
    const change = closes[i] - closes[i - 1];
    if (change > 0) gains += change; else losses -= change;
  }
  let avgGain = gains / period;
  let avgLoss = losses / period;
  for (let i = period + 1; i < closes.length; i++) {
    const change = closes[i] - closes[i - 1];
    avgGain = (avgGain * (period - 1) + (change > 0 ? change : 0)) / period;
    avgLoss = (avgLoss * (period - 1) + (change < 0 ? -change : 0)) / period;
  }
  if (avgLoss === 0) return 100;
  const rs = avgGain / avgLoss;
  return 100 - (100 / (1 + rs));
}

// --- DEEPSEEK ---
async function deepseekForecast5(symbol, contextCandles) {
  if (!SILICON_KEY) return null;
  const system = `You are an elite crypto sniper. Output JSON: { "target_price": number, "stop_loss_price": number, "direction": "LONG"|"SHORT", "confidence": 0-100, "forecast_1m": [ ...5 candles... ] }`;
  const user = `Symbol: ${symbol}. Last close: ${contextCandles[contextCandles.length-1].close}. Recent 30m closes: ${contextCandles.map(c=>c.close).join(',')}.`;
  
  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), 25000);
  try {
    const r = await fetch('https://api.siliconflow.cn/v1/chat/completions', {
      method: 'POST', headers: { Authorization: `Bearer ${SILICON_KEY}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'deepseek-ai/DeepSeek-V3', messages: [{ role: 'system', content: system }, { role: 'user', content: user }], temperature: 0.1, response_format: { type: 'json_object' } }),
      signal: controller.signal
    });
    clearTimeout(id);
    if (!r.ok) return null;
    const j = await r.json();
    const content = j?.choices?.[0]?.message?.content || '{}';
    // Clean markdown
    let cleanContent = content;
    if (content.includes('```json')) cleanContent = content.split('```json')[1].split('```')[0].trim();
    else if (content.includes('```')) cleanContent = content.split('```')[1].split('```')[0].trim();
    
    const parsed = JSON.parse(cleanContent);
    if (!parsed.target_price || !parsed.stop_loss_price || !parsed.forecast_1m) return null;
    
    return {
        candles: parsed.forecast_1m.map((c, i) => ({ t: Date.now() + (i+1)*60000, close: Number(c.close) })),
        target_price: Number(parsed.target_price),
        stop_loss_price: Number(parsed.stop_loss_price),
        direction: parsed.direction,
        confidence: Number(parsed.confidence)
    };
  } catch (e) { return null; }
}

// --- ADAPTIVE PICKER ---
async function pickAiWithAdaptiveGates(aiPool) {
  const adaptiveSteps = [
    { name: 'step1', gates: { maxSpreadPct: 0.25, minDepth: 15_000, stddevMax: 0.20 } },
    { name: 'step2', gates: { maxSpreadPct: 0.35, minDepth: 10_000, stddevMax: 0.28 } },
  ];

  const accepted = [];
  const pool = aiPool.slice();
  const majors = ['BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT', 'XRPUSDT'];

  for (const step of adaptiveSteps) {
    const passedCheap = [];
    const gates = step.gates;

    for (const t of pool) {
        if (majors.includes(t.symbol)) continue; 
        if (t.quoteVolume < MIN_QUOTEVOL_AI) { lastDemoteReasonCounts.lowPriceVol++; continue; }
        if (t.lastPrice < MIN_PRICE_AI) { lastDemoteReasonCounts.lowPriceVol++; continue; }
        passedCheap.push(t);
    }

    const shortlist = passedCheap.sort((a,b) => b.quoteVolume - a.quoteVolume).slice(0, 5);
    
    const results = await Promise.all(shortlist.map(async (candidate) => {
        try {
            const depth = await fetchMexcDepth(candidate.symbol, 20);
            if (!depth || !depth.bids.length) return null;
            const bestBid = Number(depth.bids[0][0]);
            const bestAsk = Number(depth.asks[0][0]);
            const mid = (bestBid+bestAsk)/2;
            const spreadPct = ((bestAsk-bestBid)/mid)*100;
            if (spreadPct > gates.maxSpreadPct) return null;

            const kl = await fetchMexcKlines(candidate.symbol, '1m', 35);
            const closes = kl.map(k=>Number(k[4]));
            if (closes.length < 35) return null;
            
            let flattens = 0;
            for(let i=2; i<closes.length; i++) { if(closes[i] === closes[i-2]) flattens++; }
            if (flattens > 5) { lastDemoteReasonCounts.sawtooth++; return null; }

            const ctx = kl.map(k=>({close:Number(k[4])}));
            const ds = await deepseekForecast5(candidate.symbol, ctx);
            if (!ds) return null;
            if (ds.confidence < 75) return null; 

            return { ...candidate, ...ds, spreadPct };
        } catch (e) { return null; }
    }));

    const valid = results.filter(r => r !== null);
    valid.forEach(v => accepted.push(v));
    if (accepted.length >= 1) break; 
  }
  lastAiPickCount = accepted.length;
  return accepted.slice(0, 2);
}

function loadPersistedSignals() {
  try {
    if (!fs.existsSync(DATA_FILE)) return;
    const latest = JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
    const persisted = (latest && latest.parsed && Array.isArray(latest.parsed.detected)) ? latest.parsed.detected : [];
    for (const d of persisted) {
      if (d && d.tag === 'AI' && d.symbol) {
        const copy = Object.assign({}, d);
        copy.status = copy.status || 'ACTIVE';
        copy.addedAt = copy.detectedAt || Date.now();
        copy.removeAt = copy.expiresAt || null;
        activeSignals.set(d.symbol, copy);
      }
    }
  } catch (e) { }
}

function shuffleArray(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
}

// --- MAIN SCANNER ---
async function runScannerJob() {
  if (scanInFlight) return;
  scanInFlight = true;
  console.log('\n🔍 Running Elite Scanner Job...');

  try {
    // 1. Update Existing Signals
    const all = await fetch24hrTickers();
    if (!all) throw new Error("MEXC API Fail");

    const base = all.map(x => ({ symbol: x.symbol, quoteVolume: Number(x.quoteVolume), lastPrice: Number(x.lastPrice), priceChangePercent: Number(x.priceChangePercent) }))
        .filter(x => x.symbol.endsWith('USDT') && isSaneUsdtSymbol(x.symbol) && !isStablecoinLike(x.symbol) && !isLeveraged(x.symbol));

    const baseMap = new Map(base.map(b => [b.symbol, b]));
    for (const [sym, sig] of Array.from(activeSignals.entries())) {
      const tick = baseMap.get(sym);
      if (!tick) continue;
      const price = Number(tick.lastPrice);
      if (sig.status === 'ACTIVE') {
        if (sig.target_price && price >= sig.target_price && sig.direction === 'LONG') { sig.status = 'WON'; sig.removeAt = Date.now()+300000; }
        else if (sig.stop_loss_price && price <= sig.stop_loss_price && sig.direction === 'LONG') { sig.status = 'LOST'; sig.removeAt = Date.now()+300000; }
        else if (sig.target_price && price <= sig.target_price && sig.direction === 'SHORT') { sig.status = 'WON'; sig.removeAt = Date.now()+300000; }
        else if (sig.stop_loss_price && price >= sig.stop_loss_price && sig.direction === 'SHORT') { sig.status = 'LOST'; sig.removeAt = Date.now()+300000; }
        sig.price = price;
      } else {
        if (sig.removeAt && Date.now() > sig.removeAt) activeSignals.delete(sym);
      }
    }

    // 2. Pick New AI (if slots open)
    const activeCount = Array.from(activeSignals.values()).filter(s => s.status === 'ACTIVE').length;
    let newAiPicks = [];
    if (activeCount < 5) {
        const aiPool = base.filter(x => x.quoteVolume > MIN_QUOTEVOL_AI && x.lastPrice > MIN_PRICE_AI);
        shuffleArray(aiPool); // Rotate
        newAiPicks = await pickAiWithAdaptiveGates(aiPool);
        
        for (const pick of newAiPicks) {
            if (activeSignals.has(pick.symbol)) continue;
            activeSignals.set(pick.symbol, {
                symbol: pick.symbol, tag: 'AI', price: pick.price,
                target_price: pick.target_price, stop_loss_price: pick.stop_loss_price, direction: pick.direction,
                forecastCandles: pick.forecastCandles, detectedAt: Date.now(), status: 'ACTIVE',
                stdDev: pick.stdDev, quoteVolume: pick.quoteVolume, change24hPct: pick.priceChangePercent,
                addedAt: Date.now()
            });
        }
    }

    // 3. Pick FT
    const aiSymbols = Array.from(activeSignals.keys());
    const ftPool = base.filter(x => x.quoteVolume >= MIN_QUOTEVOL_FT && x.lastPrice >= MIN_PRICE_FT && !aiSymbols.includes(x.symbol));
    const ftPicks = [];
    const ftCandidates = ftPool.sort((a,b) => Math.abs(b.priceChangePercent) - Math.abs(a.priceChangePercent)).slice(0, 60);

    for (let i=0; i<ftCandidates.length; i+=CHUNK_SIZE) {
        const chunk = ftCandidates.slice(i, i+CHUNK_SIZE);
        await Promise.all(chunk.map(async (t) => {
            const kl = await fetchMexcKlines(t.symbol, '1m', 20);
            const closes = kl.map(k=>Number(k[4]));
            if (closes.length < 15) return;
            const rsi = calculateRSI(closes, 14);
            let signal = 'NEUTRAL';
            if (rsi < 35) signal = 'LONG';
            if (rsi > 65) signal = 'SHORT';
            ftPicks.push({ ...t, rsi, signal, tag: 'FT', stdDev: relStdDevPct(closes) });
        }));
    }

    // 4. Assemble & Broadcast
    const finalDetected = [];
    const forecasts = {};

    for (const [sym, sig] of activeSignals.entries()) {
        finalDetected.push(sig);
        if (sig.forecastCandles) {
            forecasts[sym] = {
                source: 'deepseek', candles: sig.forecastCandles,
                target_price: sig.target_price, stop_loss_price: sig.stop_loss_price, direction: sig.direction, status: sig.status
            };
        }
    }

    // FT Balancing
    const longs = ftPicks.filter(f => f.signal === 'LONG').slice(0,7);
    const shorts = ftPicks.filter(f => f.signal === 'SHORT').slice(0,7);
    const vols = ftPicks.filter(f => f.signal === 'NEUTRAL').slice(0,6);
    const finalFT = [...longs, ...shorts, ...vols];
    
    finalFT.forEach(ft => finalDetected.push({
        symbol: ft.symbol, tag: 'FT', price: ft.lastPrice, stdDev: ft.stdDev, quoteVolume: ft.quoteVolume,
        change24hPct: ft.priceChangePercent, detectedAt: Date.now(), expiresAt: Date.now()+600000, signal: ft.signal, rsi: ft.rsi
    }));

    console.log(`✅ Final: AI=${activeSignals.size}, FT=${finalFT.length}`);

    const payload = {
        ts: new Date().toISOString(),
        nextScanAt: Date.now() + UI_INTERVAL,
        parsed: { detected: finalDetected, forecastsBySymbol: forecasts }
    };

    fs.writeFileSync(DATA_FILE, JSON.stringify(payload));
    sseBroadcast('scheduled_update', payload);

    setTimeout(runScannerJob, Math.max(0, UI_INTERVAL - PRE_WORK_TIME));

  } catch (e) {
    console.error('Scan Error:', e);
    setTimeout(runScannerJob, 60000);
  } finally {
    scanInFlight = false;
  }
}

