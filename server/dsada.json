import React, { useEffect, useRef, useState } from 'react';
import {
  createChart,
  IChartApi,
  LineStyle,
  CandlestickData,
  LineData,
  ISeriesApi,
  ColorType,
} from 'lightweight-charts';

interface Props {
  symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = '—' }) => {
  const ref = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const resizeObserverRef = useRef<ResizeObserver | null>(null);
  
  const candlestickSeriesRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const forecastSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);

  const [candles, setCandles] = useState<CandlestickData[]>([]);
  const [forecast, setForecast] = useState<LineData[]>([]);

  // 1. Fetch Candles
  useEffect(() => {
    if (!symbol || symbol.includes('—') || symbol.length < 4) {
      setCandles([]);
      return;
    }
    
    console.log(`[Chart Debug] Fetching candles for: ${symbol}`);
    
    const fetchCandles = async () => {
      try {
        const response = await fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol)}&limit=50`);
        const data = await response.json();
        
        if (Array.isArray(data) && data.length > 0) {
          const formatted = data.map((c: any) => ({
              time: Math.floor(c.time),
              open: Number(c.open),
              high: Number(c.high),
              low: Number(c.low),
              close: Number(c.close),
            })).sort((a: any, b: any) => a.time - b.time);
          
          console.log(`[Chart Debug] Loaded ${formatted.length} candles. Last close: ${formatted[formatted.length-1].close}`);
          setCandles(formatted);
        } else {
          console.warn('[Chart Debug] No candles returned');
          setCandles([]);
        }
      } catch (error) {
        console.error('[Chart Debug] Candle fetch error:', error);
      }
    };
    fetchCandles();
  }, [symbol]);

  // 2. Fetch Forecast
  useEffect(() => {
    const fetchForecast = async () => {
      try {
        const response = await fetch('/api/scheduler/latest');
        const data = await response.json();
        const parsed = data.parsed || data;
        
        if (parsed.forecast_1m && Array.isArray(parsed.forecast_1m)) {
          const formatted = parsed.forecast_1m.map((f: any) => ({
            time: Math.floor(Number(f.t) / 1000), 
            value: Number(f.close),
          })).sort((a: any, b: any) => a.time - b.time);
          
          console.log(`[Chart Debug] Loaded forecast. Points: ${formatted.length}. First val: ${formatted[0]?.value}`);
          setForecast(formatted);
        }
      } catch (error) {
        console.error('[Chart Debug] Forecast fetch error:', error);
      }
    };
    fetchForecast();
  }, []);

  // 3. Init Chart
  useEffect(() => {
    if (!ref.current) return;
    
    // Удаляем старый график если есть
    if (chartRef.current) {
        chartRef.current.remove();
    }

    const chart = createChart(ref.current, {
      width: ref.current.clientWidth || 800,
      height: 400,
      layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: '#9ca3af' },
      grid: { vertLines: { color: 'rgba(255, 255, 255, 0.05)' }, horzLines: { color: 'rgba(255, 255, 255, 0.05)' } },
      timeScale: { timeVisible: true, secondsVisible: false }
    });
    
    chartRef.current = chart;
    candlestickSeriesRef.current = chart.addCandlestickSeries({ upColor: '#22c55e', downColor: '#ef4444' });
    forecastSeriesRef.current = chart.addLineSeries({ color: '#8b5cf6', lineStyle: LineStyle.Dashed, lineWidth: 2 });

    const resizeObserver = new ResizeObserver(() => {
      if (chartRef.current && ref.current) {
        chartRef.current.applyOptions({ width: ref.current.clientWidth, height: ref.current.clientHeight });
      }
    });
    resizeObserver.observe(ref.current);

    return () => { resizeObserver.disconnect(); chart.remove(); };
  }, []);

  // 4. Update & Scale Logic
  useEffect(() => {
    if (!chartRef.current || !candlestickSeriesRef.current || !forecastSeriesRef.current) return;

    // Update Candles
    if (candles.length > 0) {
      candlestickSeriesRef.current.setData(candles);
    }

    // SCALING LOGIC
    if (candles.length > 0 && forecast.length > 0) {
        const lastReal = candles[candles.length - 1];
        const lastRealPrice = Number(lastReal.close);
        const lastRealTime = Number(lastReal.time);
        
        const firstForecastVal = Number(forecast[0].value);

        console.log(`[Chart Debug] SCALING START. Real: ${lastRealPrice}, ForecastBase: ${firstForecastVal}`);

        if (firstForecastVal) {
            const mapped = forecast.map((f, i) => {
                const ratio = f.value / firstForecastVal;
                const newVal = lastRealPrice * ratio;
                return {
                    time: lastRealTime + (i + 1) * 60,
                    value: newVal
                };
            });
            console.log(`[Chart Debug] Scaled first point to: ${mapped[0].value}`);
            forecastSeriesRef.current.setData(mapped);
        }
    } else {
        // Если данных не хватает
        forecastSeriesRef.current.setData([]);
    }
    
    chartRef.current.timeScale().fitContent();

  }, [candles, forecast]);

  return (
    <div className="w-full h-full drop-shadow-[0_0_10px_rgba(139,92,246,0.5)]">
      <div ref={ref} className="w-full h-full" />
    </div>
  );
};

export default ChartContainer;

