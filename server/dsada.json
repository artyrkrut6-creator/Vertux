A) server/real-server.js
========================
```js
require('dotenv').config();
const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');

const PORT = Number(process.env.PORT || 5176);
const app = express();

app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '2mb' }));

const DATA_FILE = path.join(__dirname, 'last_scheduled_prediction.json');

// --- Tier thresholds (whale-resistant approximation) ---
const TIER_AI = { minQuoteVolume: 500_000, maxRelStdDevPct: 0.12, maxPicks: 2 };
const TIER_FT = { minQuoteVolume: 150_000, maxRelStdDevPct: 0.50, maxPicks: 25 };

// Scanner batching
const TOP_VOLATILE = 50;
const CHUNK_SIZE = 5;
const KLINES_LIMIT = 15;
const SCAN_INTERVAL_MS = 60_000;

// If you have SiliconFlow DeepSeek key in server/.env: SILICON_KEY=...
const SILICON_KEY = process.env.SILICON_KEY || process.env.SILICON_FLOW_API_KEY || null;

// --- SSE ---
const sseClients = new Set();
function sseBroadcast(eventName, payload) {
  const data = JSON.stringify(payload).replace(/\r?\n/g, '');
  for (const res of Array.from(sseClients)) {
    try {
      res.write(`event: ${eventName}\n`);
      res.write(`data: ${data}\n\n`);
    } catch (_) {}
  }
}

function ensureDataFileExists() {
  if (!fs.existsSync(DATA_FILE)) {
    const init = { ts: new Date().toISOString(), parsed: { detected: [], forecastsBySymbol: {} } };
    fs.writeFileSync(DATA_FILE, JSON.stringify(init, null, 2));
  }
}

function safeReadLatest() {
  try {
    ensureDataFileExists();
    const raw = fs.readFileSync(DATA_FILE, 'utf8');
    return JSON.parse(raw);
  } catch (_) {
    return { ts: new Date().toISOString(), parsed: { detected: [], forecastsBySymbol: {} } };
  }
}

function safeWriteLatest(obj) {
  try {
    fs.writeFileSync(DATA_FILE, JSON.stringify(obj, null, 2));
  } catch (e) {
    console.error('write latest error:', e);
  }
}

function sleep(ms) {
  return new Promise(r => setTimeout(r, ms));
}

// --- MEXC API ---
async function mexcFetchJSON(url) {
  const res = await fetch(url, { method: 'GET' });
  if (!res.ok) {
    const txt = await res.text().catch(() => '');
    throw new Error(`MEXC ${res.status}: ${String(txt).slice(0,200)}`);
  }
  return res.json();
}

function isSaneUsdtSymbol(sym) {
  // Keep only plain ASCII tickers like ABC123USDT
  // avoid Chinese chars etc that can break charting
  return /^[A-Z0-9]{2,}USDT$/.test(sym);
}

function isStablecoinLike(sym) {
  // avoid USDCUSDT, USD1USDT, etc
  return /USDC|USDP|TUSD|DAI|FDUSD|USD1/.test(sym);
}

async function fetch24hrTickers() {
  return mexcFetchJSON('https://api.mexc.com/api/v3/ticker/24hr');
}

async function fetchMexcKlines(symbol, interval = '1m', limit = 15) {
  const url = `https://api.mexc.com/api/v3/klines?symbol=${encodeURIComponent(symbol)}&interval=${encodeURIComponent(interval)}&limit=${encodeURIComponent(limit)}`;
  const res = await fetch(url);
  if (!res.ok) {
    const txt = await res.text().catch(() => '');
    console.warn(`/api/live/candles: mexc returned ${res.status} for symbol=${symbol}: ${String(txt).slice(0,120)}`);
    return [];
  }
  const data = await res.json();
  // Format: [time, open, high, low, close, volume, ...]
  return Array.isArray(data) ? data : [];
}

function computeStdDev(values) {
  if (!values.length) return 0;
  const mean = values.reduce((s, v) => s + v, 0) / values.length;
  const variance = values.reduce((s, v) => s + (v - mean) * (v - mean), 0) / values.length;
  return Math.sqrt(variance);
}

function relStdDevPct(closes) {
  if (!closes.length) return 999;
  const mean = closes.reduce((s,v)=>s+v,0)/closes.length;
  if (!mean) return 999;
  const sd = computeStdDev(closes);
  return (sd / mean) * 100;
}

// --- DeepSeek forecast (5x 1m candles) ---
async function deepseekForecast5(symbol, contextCandles) {
  // contextCandles: [{t, o, h, l, c}] best effort
  if (!SILICON_KEY) return null;

  const system = `
You are a crypto market forecaster.
Return ONLY a JSON object with key "forecast_1m" which is an array of exactly 5 candles.
Each candle MUST have: offset_minutes (1..5), open, high, low, close as numbers.
No markdown, no extra keys.
`.trim();

  const user = `
Symbol: ${symbol}
Recent candles (1m):
${contextCandles.map((c,i)=>`#${i+1} o:${c.open} h:${c.high} l:${c.low} c:${c.close}`).join('\n')}
Return 5 forecast candles as requested.
`.trim();

  const body = {
    model: 'deepseek-ai/DeepSeek-V3',
    messages: [
      { role: 'system', content: system },
      { role: 'user', content: user },
    ],
    temperature: 0.2,
    max_tokens: 600,
    response_format: { type: 'json_object' },
  };

  const r = await fetch('https://api.siliconflow.cn/v1/chat/completions', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${SILICON_KEY}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(body),
  });

  if (!r.ok) {
    const txt = await r.text().catch(()=>'');
    console.warn('DeepSeek error:', r.status, String(txt).slice(0,200));
    return null;
  }

  const j = await r.json();
  const content = j?.choices?.[0]?.message?.content;
  if (!content) return null;

  let parsed;
  try {
    parsed = typeof content === 'string' ? JSON.parse(content) : content;
  } catch {
    const m = String(content).match(/\{[\s\S]*\}/);
    if (!m) return null;
    parsed = JSON.parse(m[0]);
  }

  const arr = parsed?.forecast_1m;
  if (!Array.isArray(arr) || arr.length !== 5) return null;

  // Normalize
  const now = Date.now();
  return arr.map((c, idx) => {
    const offset = Number(c.offset_minutes || (idx+1));
    return {
      t: now + offset * 60_000,
      open: Number(c.open),
      high: Number(c.high),
      low: Number(c.low),
      close: Number(c.close),
    };
  });
}

function mockForecast5(anchorPrice) {
  const now = Date.now();
  const out = [];
  let p = Number(anchorPrice) || 1;
  for (let i=1;i<=5;i++){
    const drift = (Math.random()-0.5) * 0.002; // ±0.2%
    const close = p * (1 + drift);
    out.push({
      t: now + i*60_000,
      open: p,
      high: Math.max(p, close) * (1 + Math.random()*0.0008),
      low: Math.min(p, close) * (1 - Math.random()*0.0008),
      close,
    });
    p = close;
  }
  return out;
}

// --- SCANNER JOB ---
async function runScannerJob() {
  const jobTs = Date.now();
  console.log('\n🔍 Running Elite Scanner Job...');
  try {
    const all = await fetch24hrTickers();

    // Step 1: filter USDT + sane + non-stable-ish + volume >= FT min
    const filtered = (Array.isArray(all) ? all : [])
      .map(x => ({
        symbol: String(x.symbol || '').toUpperCase(),
        quoteVolume: Number(x.quoteVolume || 0),
        lastPrice: Number(x.lastPrice || x.price || 0),
        priceChangePercent: Number(x.priceChangePercent || 0),
      }))
      .filter(x =>
        x.symbol.endsWith('USDT') &&
        isSaneUsdtSymbol(x.symbol) &&
        !isStablecoinLike(x.symbol) &&
        x.quoteVolume >= TIER_FT.minQuoteVolume &&
        x.lastPrice > 0
      );

    // Step 2: take top 50 by volatility (abs change %) to follow your original batching spec
    filtered.sort((a,b)=>Math.abs(b.priceChangePercent)-Math.abs(a.priceChangePercent));
    const top50 = filtered.slice(0, TOP_VOLATILE);

    console.log(`📊 Candidates: ${filtered.length}, scanning top ${top50.length}`);

    const detected = [];
    const bySymbolMeta = new Map();

    // Step 3: batching in chunks of 5
    for (let i=0;i<top50.length;i+=CHUNK_SIZE) {
      const chunk = top50.slice(i, i+CHUNK_SIZE);
      console.log(`🔄 Chunk ${Math.floor(i/CHUNK_SIZE)+1}: ${chunk.map(c=>c.symbol).join(', ')}`);

      const results = await Promise.all(chunk.map(async (t) => {
        const kl = await fetchMexcKlines(t.symbol, '1m', KLINES_LIMIT);
        const closes = kl.map(k => Number(k[4])).filter(v => Number.isFinite(v) && v > 0);
        if (closes.length < 10) return null;

        const devPct = relStdDevPct(closes); // percent
        const tag =
          (t.quoteVolume >= TIER_AI.minQuoteVolume && devPct <= TIER_AI.maxRelStdDevPct) ? 'AI' :
          (t.quoteVolume >= TIER_FT.minQuoteVolume && devPct <= TIER_FT.maxRelStdDevPct) ? 'FT' :
          null;

        if (!tag) return null;

        return {
          symbol: t.symbol,
          tag,
          price: t.lastPrice,
          stdDev: devPct,
          quoteVolume: t.quoteVolume,
          // detectedAt/expiresAt set later (AI uses forecast time)
          _klines: kl,
        };
      }));

      for (const r of results) {
        if (!r) continue;
        detected.push(r);
        bySymbolMeta.set(r.symbol, r);
      }

      // small pause between chunks
      await sleep(250);
    }

    // Step 4: rank
    // AI first: highest volume, lowest stdDev
    const ai = detected.filter(x => x.tag === 'AI')
      .sort((a,b)=> (b.quoteVolume - a.quoteVolume) || (a.stdDev - b.stdDev))
      .slice(0, TIER_AI.maxPicks);

    const ft = detected.filter(x => x.tag === 'FT')
      .sort((a,b)=> (b.quoteVolume - a.quoteVolume) || (a.stdDev - b.stdDev))
      .slice(0, TIER_FT.maxPicks);

    // Build final detected list with correct timestamps
    const finalDetected = [];
    const forecastsBySymbol = {};

    // For AI: forecast now, set detectedAt = forecastGeneratedAt, expiresAt = +5m
    for (const coin of ai) {
      const forecastGeneratedAt = Date.now();
      const expiresAt = forecastGeneratedAt + 5 * 60_000;

      const kl = coin._klines || [];
      const ctx = kl.slice(-15).map(k => ({
        time: Number(k[0]),
        open: Number(k[1]),
        high: Number(k[2]),
        low: Number(k[3]),
        close: Number(k[4]),
      }));

      let forecast = await deepseekForecast5(coin.symbol, ctx);
      if (!forecast) forecast = mockForecast5(coin.price);

      forecastsBySymbol[coin.symbol] = {
        generatedAt: forecastGeneratedAt,
        horizonMinutes: 5,
        candles: forecast,
      };

      finalDetected.push({
        symbol: coin.symbol,
        tag: 'AI',
        price: coin.price,
        stdDev: coin.stdDev,
        quoteVolume: coin.quoteVolume,
        detectedAt: forecastGeneratedAt,
        expiresAt,
      });
    }

    // For FT: no forecast, expiresAt +10m
    const ftNow = Date.now();
    for (const coin of ft) {
      // avoid duplicating AI in FT
      if (finalDetected.some(x => x.symbol === coin.symbol)) continue;

      finalDetected.push({
        symbol: coin.symbol,
        tag: 'FT',
        price: coin.price,
        stdDev: coin.stdDev,
        quoteVolume: coin.quoteVolume,
        detectedAt: ftNow,
        expiresAt: ftNow + 10 * 60_000,
      });
    }

    console.log(`✅ Final picks: AI=${finalDetected.filter(x=>x.tag==='AI').length}, FT=${finalDetected.filter(x=>x.tag==='FT').length}`);

    const payload = {
      ts: new Date(jobTs).toISOString(),
      parsed: {
        detected: finalDetected,
        forecastsBySymbol,
      },
    };

    safeWriteLatest(payload);
    sseBroadcast('scheduled_update', payload);
  } catch (e) {
    console.error('❌ Scanner job error:', e);
  }
}

