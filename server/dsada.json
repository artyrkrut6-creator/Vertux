        const r = await fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol)}&limit=80`);
        const j = await r.json();
        const formatted: CandlestickData[] = (Array.isArray(j) ? j : []).map((c: any) => ({
          time: Number(c.time),
          open: Number(c.open),
          high: Number(c.high),
          low: Number(c.low),
          close: Number(c.close),
        })).sort((a,b)=>Number(a.time)-Number(b.time));
