import React, { useEffect, useRef, useState } from 'react';
import {
  createChart,
  IChartApi,
  LineStyle,
  ColorType,
  CandlestickData,
  LineData,
  ISeriesApi,
} from 'lightweight-charts';

type ForecastPack = {
  source?: 'deepseek' | 'mock';
  candles?: Array<{ t: number; open: number; high: number; low: number; close: number }>;
};

interface Props {
  symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = 'BTCUSDT' }) => {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const candleSeriesRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const forecastSeriesRef = useRef<ISeriesApi<'Line'> | null>(null);

  const liveEsRef = useRef<EventSource | null>(null);
  const schedEsRef = useRef<EventSource | null>(null);

  const [candles, setCandles] = useState<CandlestickData[]>([]);
  const [forecast, setForecast] = useState<LineData[]>([]);

  const sym = (symbol || 'BTCUSDT').toUpperCase();

  // 1) Init chart once
  useEffect(() => {
    if (!containerRef.current) return;

    const chart = createChart(containerRef.current, {
      width: containerRef.current.clientWidth,
      height: containerRef.current.clientHeight || 420,
      layout: {
        background: { type: ColorType.Solid, color: 'transparent' },
        textColor: '#9ca3af',
      },
      grid: {
        vertLines: { color: 'rgba(255,255,255,0.05)' },
        horzLines: { color: 'rgba(255,255,255,0.05)' },
      },
      crosshair: {
        vertLine: { color: '#8b5cf6', style: LineStyle.Dashed },
        horzLine: { color: '#8b5cf6', style: LineStyle.Dashed },
      },
      timeScale: { timeVisible: true, secondsVisible: false },
    });

    chartRef.current = chart;

    candleSeriesRef.current = chart.addCandlestickSeries({
      upColor: '#22c55e',
      downColor: '#ef4444',
      wickUpColor: '#22c55e',
      wickDownColor: '#ef4444',
      borderVisible: false,
    });

    forecastSeriesRef.current = chart.addLineSeries({
      color: '#8b5cf6',
      lineWidth: 2,
      lineStyle: LineStyle.Dashed,
    });

    const ro = new ResizeObserver(() => {
      if (!containerRef.current || !chartRef.current) return;
      chartRef.current.applyOptions({
        width: containerRef.current.clientWidth,
        height: containerRef.current.clientHeight,
      });
    });
    ro.observe(containerRef.current);

    return () => {
      ro.disconnect();
      chart.remove();
      chartRef.current = null;
      candleSeriesRef.current = null;
      forecastSeriesRef.current = null;
    };
  }, []);

  // 2) Load initial history candles when symbol changes
  useEffect(() => {
    let dead = false;

    (async () => {
      try {
        const r = await fetch(`/api/live/candles?symbol=${encodeURIComponent(sym)}&limit=120`);
        const j = await r.json();

        const formatted: CandlestickData[] = (Array.isArray(j) ? j : [])
          .map((c: any) => ({
            time: Number(c.time), // seconds
            open: Number(c.open),
            high: Number(c.high),
            low: Number(c.low),
            close: Number(c.close),
          }))
          .sort((a, b) => Number(a.time) - Number(b.time));

        if (!dead) setCandles(formatted);
      } catch {
        if (!dead) setCandles([]);
      }
    })();

    return () => {
      dead = true;
    };
  }, [sym]);

  // 3) Apply candle history to chart
  useEffect(() => {
    if (!candleSeriesRef.current || !chartRef.current) return;
    candleSeriesRef.current.setData(candles);
    chartRef.current.timeScale().fitContent();
  }, [candles]);

  // 4) Live stream candles via SSE (/api/live/stream?symbol=...)
  useEffect(() => {
    // close previous stream
    try {
      liveEsRef.current?.close();
    } catch {}
    liveEsRef.current = null;

    const es = new EventSource(`/api/live/stream?symbol=${encodeURIComponent(sym)}`);
    liveEsRef.current = es;

    const onCandle = (ev: MessageEvent) => {
      try {
        const c = JSON.parse(ev.data);
        // expects {time, open, high, low, close} with time in seconds
        const candle: CandlestickData = {
          time: Number(c.time),
          open: Number(c.open),
          high: Number(c.high),
          low: Number(c.low),
          close: Number(c.close),
        };

        if (candleSeriesRef.current) {
          candleSeriesRef.current.update(candle);
        }
      } catch {}
    };

    es.addEventListener('candle_update', onCandle as any);

    es.addEventListener('error', () => {
      // transient network errors are normal; browser will retry
    });

    return () => {
      try {
        es.removeEventListener('candle_update', onCandle as any);
        es.close();
      } catch {}
      if (liveEsRef.current === es) liveEsRef.current = null;
    };
  }, [sym]);

  // helper: extract forecast pack for current symbol
  const extractForecastForSymbol = (payload: any, symbolUpper: string): LineData[] => {
    const parsed = payload?.parsed || payload;
    const fb = parsed?.forecastsBySymbol || {};
    const pack: ForecastPack | undefined = fb?.[symbolUpper];

    // Only show real DeepSeek forecasts
    if (!pack || pack.source !== 'deepseek' || !Array.isArray(pack.candles) || pack.candles.length !== 5) {
      return [];
    }

    return pack.candles
      .map((x) => ({
        time: Math.floor(Number(x.t) / 1000),
        value: Number(x.close),
      }))
      .sort((a, b) => a.time - b.time);
  };

  // 5) Load forecast snapshot initially + update via /events scheduled_update
  useEffect(() => {
    let dead = false;

    // initial snapshot
    (async () => {
      try {
        const r = await fetch('/api/scheduler/latest');
        if (!r.ok) return;
        const j = await r.json();
        const line = extractForecastForSymbol(j, sym);
        if (!dead) setForecast(line);
      } catch {}
    })();

    // listen to scheduled_update so forecast changes live when scanner updates
    try {
      schedEsRef.current?.close();
    } catch {}
    schedEsRef.current = null;

    const es = new EventSource('/events');
    schedEsRef.current = es;

    const onScheduled = (ev: MessageEvent) => {
      try {
        const j = JSON.parse(ev.data);
        const line = extractForecastForSymbol(j, sym);
        if (!dead) setForecast(line);
      } catch {}
    };

    es.addEventListener('scheduled_update', onScheduled as any);

    return () => {
      dead = true;
      try {
        es.removeEventListener('scheduled_update', onScheduled as any);
        es.close();
      } catch {}
      if (schedEsRef.current === es) schedEsRef.current = null;
    };
  }, [sym]);

  // 6) Apply forecast to chart (empty => hidden)
  useEffect(() => {
    if (!forecastSeriesRef.current || !chartRef.current) return;
    forecastSeriesRef.current.setData(forecast);
    chartRef.current.timeScale().fitContent();
  }, [forecast]);

  return (
    <div className="w-full h-full drop-shadow-[0_0_15px_rgba(139,92,246,0.15)]">
      <div ref={containerRef} className="w-full h-[420px]" />
    </div>
  );
};

export default ChartContainer;

