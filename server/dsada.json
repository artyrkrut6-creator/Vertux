        const [forecast, setForecast] = useState<LineData[]>([])

        // Fetch historical candles
        useEffect(() => {
          if (!symbol || symbol.includes('—') || symbol.includes('-') || symbol.length < 4) {
            setCandles([])
            return
          }
          let cancelled = false
          const fetchCandles = async () => {
            try {
              const response = await fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol)}&limit=50`)
              if (!response.ok) throw new Error('Failed to fetch candles')
              const data = await response.json()
              const formatted: CandlestickData[] = Array.isArray(data)
                ? data.map((c: any) => ({
                    time: Math.floor(c.time),
                    open: Number(c.open),
                    high: Number(c.high),
                    low: Number(c.low),
                    close: Number(c.close),
                  }))
                : []
              if (!cancelled) setCandles(formatted)
            } catch (error) {
              console.error('Error fetching candles:', error)
              if (!cancelled) setCandles([])
            }
          }
          fetchCandles()
          return () => {
            cancelled = true
          }
        }, [symbol])

        // Fetch forecast data
        useEffect(() => {
          let cancelled = false
          const fetchForecast = async () => {
            try {
              const response = await fetch('/api/scheduler/latest')
              if (!response.ok) throw new Error('Failed to fetch forecast')
              const data = await response.json()
              const parsed = data.parsed || data
              if (parsed.forecast_1m && Array.isArray(parsed.forecast_1m)) {
                const formatted: LineData[] = parsed.forecast_1m.map((f: any) => ({
                  time: Math.floor(Number(f.t) / 1000), // convert ms to seconds if needed
                  value: Number(f.close),
                }))
                if (!cancelled) setForecast(formatted)
              } else {
                if (!cancelled) setForecast([])
              }
            } catch (error) {
              console.error('Error fetching forecast:', error)
              if (!cancelled) setForecast([])
            }
          }
          fetchForecast()
          return () => {
            cancelled = true
          }
        }, [])

        // Create chart and series once
        useEffect(() => {
          if (!ref.current) return
          const chart = createChart(ref.current, {
            width: ref.current.clientWidth || 800,
            height: 400,
            layout: {
              background: { type: ColorType.Solid, color: 'transparent' },
              textColor: '#9ca3af',
            },
            grid: {
              vertLines: { color: 'rgba(255, 255, 255, 0.05)' },
              horzLines: { color: 'rgba(255, 255, 255, 0.05)' },
            },
            crosshair: {
              horzLine: { color: '#8b5cf6', style: LineStyle.Dashed },
              vertLine: { color: '#8b5cf6', style: LineStyle.Dashed },
            },
          })
          chartRef.current = chart

          const candlestickSeries = chart.addCandlestickSeries({
            upColor: '#22c55e',
            downColor: '#ef4444',
            wickUpColor: '#22c55e',
            wickDownColor: '#ef4444',
          })
          candlestickSeriesRef.current = candlestickSeries

          const forecastSeries = chart.addLineSeries({
            color: '#8b5cf6',
            lineStyle: LineStyle.Dashed,
            lineWidth: 2,
          })
          forecastSeriesRef.current = forecastSeries

          const resizeObserver = new ResizeObserver(() => {
            if (chartRef.current && ref.current) {
              chartRef.current.applyOptions({
                width: ref.current.clientWidth,
                height: ref.current.clientHeight,
              })
            }
          })
          resizeObserver.observe(ref.current)
          resizeObserverRef.current = resizeObserver

          return () => {
            try {
              resizeObserver.disconnect()
            } catch (e) {}
            if (candlestickSeriesRef.current) chart.removeSeries(candlestickSeriesRef.current)
            if (forecastSeriesRef.current) chart.removeSeries(forecastSeriesRef.current)
            chart.remove()
            chartRef.current = null
            candlestickSeriesRef.current = null
            forecastSeriesRef.current = null
          }
        }, [])

        // Update candlestick data
        useEffect(() => {
          if (candlestickSeriesRef.current) {
            candlestickSeriesRef.current.setData(candles)
            if (chartRef.current) chartRef.current.timeScale().fitContent()
          }
        }, [candles])

        // Pattern-matching scaling for forecast: wait for both candles and forecast
        useEffect(() => {
          if (!forecastSeriesRef.current) return

          try {
            if (!Array.isArray(forecast) || forecast.length === 0) {
              forecastSeriesRef.current.setData([])
              if (chartRef.current) chartRef.current.timeScale().fitContent()
              return
            }

            if (!Array.isArray(candles) || candles.length === 0) {
              // No real candles yet: set raw forecast times/values (best effort)
              forecastSeriesRef.current.setData(forecast)
              if (chartRef.current) chartRef.current.timeScale().fitContent()
              return
            }

            const lastReal = candles[candles.length - 1]
            const lastRealPrice = Number(lastReal.close)
            const lastRealTime = Number(lastReal.time) // seconds

            const firstForecastVal = Number(forecast[0].value)
            const lastForecastVal = Number(forecast[forecast.length - 1].value)

            // If firstForecastVal is valid and non-zero, use ratio-based mapping.
            // Otherwise fall back to additive offset mapping.
            let mapped: LineData[] = []
            if (firstForecastVal && !Number.isNaN(firstForecastVal) && firstForecastVal !== 0) {
              mapped = forecast.map((f, i) => {
                const ratio = Number(f.value) / firstForecastVal
                const newVal = lastRealPrice * ratio
                return {
                  // map time to last real time + (i+1) minutes
                  time: lastRealTime + (i + 1) * 60,
                  value: Number.isFinite(newVal) ? newVal : lastRealPrice,
                }
              })
            } else {
              // Fallback: translate forecast so first point equals lastRealPrice
              const offset = lastRealPrice - firstForecastVal
              mapped = forecast.map((f, i) => ({
                time: lastRealTime + (i + 1) * 60,
                value: Number.isFinite(Number(f.value) + offset) ? Number(f.value) + offset : lastRealPrice,
              }))
            }

            forecastSeriesRef.current.setData(mapped)
            if (chartRef.current) chartRef.current.timeScale().fitContent()
          } catch (err) {
            console.warn('Chart forecast scaling error:', err)
            try {
              forecastSeriesRef.current.setData(forecast)
              if (chartRef.current) chartRef.current.timeScale().fitContent()
            } catch (e) {}
          }
        }, [forecast, candles])

        return (
          <div className="w-full h-full drop-shadow-[0_0_10px_rgba(139,92,246,0.5)]">
            <div ref={ref} className="w-full h-full" />
          </div>
        )
      }

      export default ChartContainer

