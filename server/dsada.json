import React, { useEffect, useState } from 'react';
import useScannerStore from '../store/scannerStore';
import { Flame, CheckCircle, XCircle } from 'lucide-react';

interface Props { onSelect: (s: string) => void; selected?: string; }

const Sidebar: React.FC<Props> = ({ onSelect, selected }) => {
  const { coins } = useScannerStore();
  const [now, setNow] = useState(Date.now());
  useEffect(() => { setInterval(() => setNow(Date.now()), 1000); }, []);

  const sorted = coins.filter(c => c.tag === 'AI').sort((a,b) => b.detectedAt - a.detectedAt);

  return (
    <div className="w-[300px] bg-[#111] border-r border-white/10 flex flex-col p-2 h-full">
      <div className="p-4 border-b border-white/10 font-bold text-white">AI SIGNALS</div>
      <div className="flex-1 overflow-y-auto space-y-2 mt-2">
        {sorted.map(c => {
            const isSelected = selected === c.symbol;
            // Status logic from server data (need to ensure store has status field)
            const status = (c as any).status || 'ACTIVE'; 
            
            return (
                <div key={c.symbol} onClick={() => onSelect(c.symbol)} 
                     className={`p-3 rounded border cursor-pointer ${isSelected ? 'bg-white/10 border-violet-500' : 'bg-black border-white/10'}`}>
                    <div className="flex justify-between items-center">
                        <span className="font-bold">{c.symbol}</span>
                        {status === 'WON' && <span className="text-green-400 flex items-center gap-1 text-xs"><CheckCircle size={12}/> WIN</span>}
                        {status === 'LOST' && <span className="text-red-400 flex items-center gap-1 text-xs"><XCircle size={12}/> LOSS</span>}
                        {status === 'ACTIVE' && <Flame size={14} className="text-violet-500 animate-pulse"/>}
                    </div>
                    <div className="text-xs text-gray-500 mt-1">
                        Entry: {c.price} • Target: {(c as any).target_price}
                    </div>
                </div>
            );
        })}
      </div>
    </div>
  );
};
export default Sidebar;

