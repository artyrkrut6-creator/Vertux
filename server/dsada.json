const path = require('path');
const { HttpsProxyAgent } = require('https-proxy-agent');

const PORT = Number(process.env.PORT || 5176);
const app = express();

app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '2mb' }));

const DATA_FILE = path.join(__dirname, 'last_scheduled_prediction.json');
const PROXY_URL = process.env.PROXY_URL || null;
let agent = null;
if (PROXY_URL) {
  try { agent = new HttpsProxyAgent(PROXY_URL); } catch (_) {}
}

// --- CONSTANTS ---
const UI_INTERVAL = 300_000; 
const PRE_WORK_TIME = 45_000; 
let scanInFlight = false;
const forecastSourceBySymbol = {};

// --- HELPERS (MUST BE DEFINED BEFORE USAGE) ---
async function mexcFetchJSON(url) {
  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), 10000);
  try {
    const res = agent ? await fetch(url, { agent, signal: controller.signal }) : await fetch(url, { signal: controller.signal });
    clearTimeout(id);
    if (!res.ok) return null;
    return res.json();
  } catch (e) { return null; }
}

async function fetch24hrTickers() { 
    return mexcFetchJSON('https://api.mexc.com/api/v3/ticker/24hr'); 
}

async function fetchMexcKlines(symbol, interval='1m', limit=50) {
  const url = `https://api.mexc.com/api/v3/klines?symbol=${encodeURIComponent(symbol)}&interval=${interval}&limit=${limit}`;
  const data = await mexcFetchJSON(url);
  return Array.isArray(data) ? data : [];
}

function sseBroadcast(evt, data) { 
    sseClients.forEach(c => c.write(`event: ${evt}\ndata: ${JSON.stringify(data)}\n\n`)); 
}
const sseClients = new Set();

// --- SCANNER JOB (DEBUG MODE: FORCE AI) ---
async function runScannerJob() {
  if (scanInFlight) return;
  scanInFlight = true;
  console.log('\n🔍 Running DEBUG Scanner Job (Forced AI)...');

  try {
    const all = await fetch24hrTickers();
    if (!all) throw new Error("MEXC API Fail");

    // Take TOP 2 Volume coins
    const base = all.map(x => ({
      symbol: x.symbol, quoteVolume: Number(x.quoteVolume), lastPrice: Number(x.lastPrice), priceChangePercent: Number(x.priceChangePercent)
    })).filter(x => x.symbol.endsWith('USDT'))
       .sort((a,b) => b.quoteVolume - a.quoteVolume)
       .slice(0, 2);

    const finalDetected = [];
    const forecasts = {};

    // Force AI on these 2
    for (const coin of base) {
        const now = Date.now();
        const price = coin.lastPrice;
        
        // Mock Forecast
        const target = price * 1.005; // +0.5%
        const stop = price * 0.995;   // -0.5%
        const candles = [];
        for(let i=1; i<=5; i++) {
            candles.push({ t: now + i*60000, close: price * (1 + (i*0.001)) });
        }

        forecasts[coin.symbol] = {
            generatedAt: now, horizonMinutes: 5, candles: candles, source: 'deepseek', // FAKE DEEPSEEK TAG
            target_price: target, stop_loss_price: stop, direction: 'LONG'
        };
        
        finalDetected.push({
            symbol: coin.symbol, tag: 'AI', price: price, stdDev: 0, quoteVolume: coin.quoteVolume,
            change24hPct: coin.priceChangePercent, detectedAt: now, expiresAt: now + 300000,
            signal: 'LONG', spreadPct: 0.01, depthUSDT: 1000000
        });
        forecastSourceBySymbol[coin.symbol] = 'deepseek';
    }

    console.log(`✅ DEBUG: Created ${finalDetected.length} AI Signals (Fake)`);

    const payload = {
        ts: new Date().toISOString(),
        nextScanAt: Date.now() + UI_INTERVAL,
        parsed: { detected: finalDetected, forecastsBySymbol: forecasts }
    };

    fs.writeFileSync(DATA_FILE, JSON.stringify(payload));
    sseBroadcast('scheduled_update', payload);

    setTimeout(runScannerJob, UI_INTERVAL - PRE_WORK_TIME);

  } catch (e) {
    console.error('Scan Error:', e);
    setTimeout(runScannerJob, 10000);
  } finally {
    scanInFlight = false;
  }
}

// --- ROUTES ---
