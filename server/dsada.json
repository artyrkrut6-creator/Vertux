JavaScript

import express from 'express';
import cors from 'cors';
import bodyParser from 'body-parser';

const app = express();
const PORT = 5176;

// --- 1. CONFIG & STATE ---
// Разрешаем и localhost, и 127.0.0.1 (Fix CORS)
app.use(cors({
  origin: ['http://localhost:5173', 'http://127.0.0.1:5173', 'http://localhost:5174'],
  credentials: true
}));
app.use(bodyParser.json());

// Хранилище текущих обнаруженных монет (Memory Cache)
let detectedCoins = []; 
// Список активных SSE клиентов
let clients = [];

// --- 2. LOGIC: SCANNER ENGINE (Mock for now) ---
// Функция, имитирующая поиск монет с низкой волатильностью (StdDev)
function runScannerJob() {
  const symbols = ['BTCUSDT', 'ETHUSDT', 'SOLUSDT', 'XRPUSDT', 'DOGEUSDT', 'BNBUSDT', 'ADAUSDT'];
  const now = Date.now();

  // Имитируем, что мы нашли монету
  // В реальной версии здесь будет запрос к MEXC API и расчет StdDev
  const randomSymbol = symbols[Math.floor(Math.random() * symbols.length)];
  const randomPrice = 100 + Math.random() * 5000;
  const randomStdDev = (Math.random() * 0.14).toFixed(3); // < 0.15% как в промпте

  const newCoin = {
    symbol: randomSymbol,
    price: parseFloat(randomPrice.toFixed(2)),
    stdDev: parseFloat(randomStdDev),
    detectedAt: now,
    expiresAt: now + (5 * 60 * 1000) // 5 минут жизни
  };

  console.log(`[Scanner] Detected: ${newCoin.symbol} (StdDev: ${newCoin.stdDev}%)`);

  // Обновляем наш кэш (удаляем старую запись этой монеты, если была, и добавляем новую)
  detectedCoins = detectedCoins.filter(c => c.symbol !== newCoin.symbol);
  detectedCoins.push(newCoin);
  
  // Убираем совсем старые из кэша сервера
  detectedCoins = detectedCoins.filter(c => c.expiresAt > now);

  // Отправляем всем клиентам
  broadcastToClients(newCoin);
}

// Отправка данных клиентам
function broadcastToClients(coinData) {
  clients.forEach(client => {
    try {
      client.res.write(`data: ${JSON.stringify(coinData)}\n\n`);
    } catch (e) {
      console.error('[SSE] Error broadcasting:', e);
    }
  });
}

// Запускаем сканер каждые 5 секунд
setInterval(runScannerJob, 5000);


// --- 3. API ENDPOINTS ---

// SSE Endpoint
app.get('/events', (req, res) => {
  const origin = req.headers.origin;
  console.log(`[SSE] New connection from: ${origin}`);

  // Headers for SSE
  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache',
    'Connection': 'keep-alive',
    'Access-Control-Allow-Origin': origin || '*'
  });

  // 1. Сразу отправляем "ping", чтобы подтвердить соединение
  res.write(`: connected\n\n`);

  // 2. ВАЖНО: Сразу отправляем ВСЕ уже найденные монеты новому клиенту
  // Чтобы Sidebar не был пустым при перезагрузке
  if (detectedCoins.length > 0) {
    console.log(`[SSE] Sending ${detectedCoins.length} cached coins to new client`);
    detectedCoins.forEach(coin => {
      res.write(`data: ${JSON.stringify(coin)}\n\n`);
    });
  }

  // Сохраняем клиента
  const clientId = Date.now();
  const newClient = { id: clientId, res };
  clients.push(newClient);

  // Удаляем клиента при разрыве
  req.on('close', () => {
    console.log(`[SSE] Client ${clientId} disconnected`);
    clients = clients.filter(c => c.id !== clientId);
  });
});

app.get('/api/status', (req, res) => {
  res.json({ status: 'ok', active_clients: clients.length, coins_in_memory: detectedCoins.length });
});

app.listen(PORT, () => {
  console.log(`--- VORTEX AI SERVER RUNNING ON PORT ${PORT} ---`);
  console.log(`Scanner Logic: Active`);
});

