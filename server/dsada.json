ШАГ 1: src/components/ChartContainer.tsx (Чистый)

Замени всё содержимое на это:

React

import React, { useEffect, useRef, useState } from 'react';
import {
  createChart,
  IChartApi,
  LineStyle,
  ColorType,
  CandlestickData,
  LineData,
  ISeriesApi,
  IPriceLine
} from 'lightweight-charts';

interface Props {
  symbol?: string;
}

const ChartContainer: React.FC<Props> = ({ symbol = 'BTCUSDT' }) => {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const chartRef = useRef<IChartApi | null>(null);
  const candleRef = useRef<ISeriesApi<'Candlestick'> | null>(null);
  const forecastRef = useRef<ISeriesApi<'Line'> | null>(null);
  const targetLineRef = useRef<IPriceLine | null>(null);
  const stopLossLineRef = useRef<IPriceLine | null>(null);

  const [candles, setCandles] = useState<CandlestickData[]>([]);
  const [forecastPack, setForecastPack] = useState<any>(null);

  // Clear on symbol change
  useEffect(() => {
    if (candleRef.current) candleRef.current.setData([]);
    if (forecastRef.current) forecastRef.current.setData([]);
    if (targetLineRef.current) { candleRef.current?.removePriceLine(targetLineRef.current); targetLineRef.current = null; }
    if (stopLossLineRef.current) { candleRef.current?.removePriceLine(stopLossLineRef.current); stopLossLineRef.current = null; }
  }, [symbol]);

  // Fetch History
  useEffect(() => {
    let active = true;
    fetch(`/api/live/candles?symbol=${encodeURIComponent(symbol || 'BTCUSDT')}&limit=120`)
      .then(r => r.json())
      .then(data => {
        if (!active) return;
        const formatted = (Array.isArray(data) ? data : []).map((c: any) => ({
          time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close)
        })).sort((a: any, b: any) => a.time - b.time);
        setCandles(formatted);
      })
      .catch(() => {});
    return () => { active = false; };
  }, [symbol]);

  // Fetch Forecast
  useEffect(() => {
    let active = true;
    fetch('/api/scheduler/latest')
      .then(r => r.json())
      .then(j => {
        if (!active) return;
        const pack = (j?.parsed || j)?.forecastsBySymbol?.[String(symbol).toUpperCase()];
        if (pack && pack.source === 'deepseek') setForecastPack(pack);
        else setForecastPack(null);
      })
      .catch(() => {});
    return () => { active = false; };
  }, [symbol]);

  // Initialize Chart
  useEffect(() => {
    if (!containerRef.current) return;
    const chart = createChart(containerRef.current, {
      width: containerRef.current.clientWidth,
      height: containerRef.current.clientHeight,
      layout: { background: { type: ColorType.Solid, color: 'transparent' }, textColor: '#9ca3af' },
      grid: { vertLines: { color: 'rgba(255,255,255,0.05)' }, horzLines: { color: 'rgba(255,255,255,0.05)' } },
      timeScale: { timeVisible: true, secondsVisible: false },
    });
    chartRef.current = chart;
    candleRef.current = chart.addCandlestickSeries({ upColor: '#22c55e', downColor: '#ef4444' });
    forecastRef.current = chart.addLineSeries({ color: '#8b5cf6', lineWidth: 2, lineStyle: LineStyle.Dashed });

    const ro = new ResizeObserver(() => {
      if (chartRef.current && containerRef.current) {
        chartRef.current.applyOptions({ width: containerRef.current.clientWidth, height: containerRef.current.clientHeight });
      }
    });
    ro.observe(containerRef.current);

    return () => { ro.disconnect(); chart.remove(); };
  }, []);

  // Render Data
  useEffect(() => {
    if (!candleRef.current || !forecastRef.current) return;
    if (candles.length > 0) candleRef.current.setData(candles);

    if (forecastPack && forecastPack.candles) {
        const line = forecastPack.candles.map((c: any) => ({ time: Math.floor(c.t/1000), value: c.close }));
        forecastRef.current.setData(line);
        // Lines
        if (targetLineRef.current) { candleRef.current.removePriceLine(targetLineRef.current); targetLineRef.current = null; }
        if (forecastPack.target_price) {
            targetLineRef.current = candleRef.current.createPriceLine({
                price: forecastPack.target_price,
                color: forecastPack.direction === 'SHORT' ? '#ef4444' : '#22c55e',
                lineWidth: 2, lineStyle: LineStyle.Solid, title: 'TARGET', axisLabelVisible: true
            });
        }
        if (stopLossLineRef.current) { candleRef.current.removePriceLine(stopLossLineRef.current); stopLossLineRef.current = null; }
        if (forecastPack.stop_loss_price) {
            stopLossLineRef.current = candleRef.current.createPriceLine({
                price: forecastPack.stop_loss_price,
                color: '#ef4444', lineWidth: 1, lineStyle: LineStyle.Dotted, title: 'STOP', axisLabelVisible: true
            });
        }
    } else {
        forecastRef.current.setData([]);
        if (targetLineRef.current) { candleRef.current.removePriceLine(targetLineRef.current); targetLineRef.current = null; }
        if (stopLossLineRef.current) { candleRef.current.removePriceLine(stopLossLineRef.current); stopLossLineRef.current = null; }
    }
    if (chartRef.current) chartRef.current.timeScale().fitContent();
  }, [candles, forecastPack]);

  // Live Stream
  useEffect(() => {
    const es = new EventSource(`/api/live/stream?symbol=${encodeURIComponent(symbol || 'BTCUSDT')}`);
    es.addEventListener('candle_update', (ev) => {
        try {
            const c = JSON.parse(ev.data);
            if (candleRef.current) candleRef.current.update({ time: Number(c.time), open: Number(c.open), high: Number(c.high), low: Number(c.low), close: Number(c.close) });
        } catch (_) {}
    });
    return () => es.close();
  }, [symbol]);

  return <div ref={containerRef} className="w-full h-full" />;
};

export default ChartContainer;

