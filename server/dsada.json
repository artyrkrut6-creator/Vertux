    'Cache-Control': 'no-cache',
    Connection: 'keep-alive',
    'Access-Control-Allow-Origin': '*',
  });

  sseClients.add(res);

  // immediate initial push
  const latest = safeReadLatest();
  try {
    res.write(`event: scheduled_update\n`);
    res.write(`data: ${JSON.stringify(latest).replace(/\r?\n/g,'')}\n\n`);
  } catch (_) {}

  // keepalive
  const ka = setInterval(() => {
    try { res.write(': ping\n\n'); } catch (_) {}
  }, 20_000);

  req.on('close', () => {
    clearInterval(ka);
    sseClients.delete(res);
  });
});

