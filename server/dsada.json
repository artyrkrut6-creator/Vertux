    // try several shapes: intervals['1m'] as object of symbol->array, detectedSymbols array, or parsed.detected
    if (parsed) {
      try {
        const intervals = parsed.intervals && parsed.intervals['1m'];
        if (intervals && typeof intervals === 'object' && !Array.isArray(intervals)) {
          const now = Date.now();
          for (const sym of Object.keys(intervals)) {
            try {
              const price = await mexcService.fetchTickerPrice(sym);
              addDetectedCoin({ symbol: sym, detectedAt: now, expiresAt: now + 5 * 60 * 1000, stdDev: 0, price });
            } catch (_) {}
          }
        }
        // detectedSymbols array
        if (Array.isArray(parsed.detectedSymbols)) {
          const now = Date.now();
          for (const sym of parsed.detectedSymbols) {
            try {
              const price = await mexcService.fetchTickerPrice(sym);
              addDetectedCoin({ symbol: sym, detectedAt: now, expiresAt: now + 5 * 60 * 1000, stdDev: 0, price });
            } catch (_) {}
          }
        }
        if (Array.isArray(parsed.detected)) {
          const now = Date.now();
          for (const item of parsed.detected) {
            const sym = item && (item.symbol || item.ticker || item); if (!sym) continue;
            try {
              const price = await mexcService.fetchTickerPrice(sym);
              addDetectedCoin({ symbol: sym, detectedAt: now, expiresAt: now + 5 * 60 * 1000, stdDev: 0, price });
            } catch (_) {}
          }
        }
      } catch (_) {}
    }
  } catch (_) {}
}, 30_000);
return () => { mounted = false; if (es) es.close(); clearInterval(pollInterval); };

}, [selected]);

// select first detected coin by default
useEffect(() => {
if (!selected && coins.length > 0) setSelected(coins[0].symbol);
}, [coins]);

const handleSelect = (s: string) => setSelected(s);
// debug
useEffect(() => { console.log('[Layout] selected changed', selected); }, [selected]);

return (
<div className="min-h-screen bg-[#050505] text-white">
<div className="max-w-[1280px] mx-auto flex gap-6">
<Sidebar onSelect={handleSelect} selected={selected} />
<main className="flex-1 p-4">
<div className="p-4 rounded-xl bg-white/5 min-h-[420px]">
<ChartContainer symbol={selected ?? 'BTCUSDT'} />
</div>
</main>
</div>
<SmartSearchButton onSelect={handleSelect} />
</div>
);
};

export default Layout;
