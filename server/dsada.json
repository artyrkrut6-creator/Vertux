// --- ADAPTIVE PICKER (FAST) ---
async function pickAiWithAdaptiveGates(aiPool) {
// Relaxed Gates for Speed
const adaptiveSteps = [
{ name: 'step1', gates: { maxSpreadPct: 0.25, minDepth: 15_000, stddevMax: 0.20 } },
{ name: 'step2', gates: { maxSpreadPct: 0.35, minDepth: 10_000, stddevMax: 0.28 } },
];

const accepted = [];
const pool = aiPool.slice();
const majors = ['BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT', 'XRPUSDT'];

for (const step of adaptiveSteps) {
const passedCheap = [];
const gates = step.gates;

text

for (const t of pool) {
    if (majors.includes(t.symbol)) continue; 
    if (t.quoteVolume < MIN_QUOTEVOL_AI) { lastDemoteReasonCounts.lowPriceVol++; continue; }
    if (t.lastPrice < MIN_PRICE_AI) { lastDemoteReasonCounts.lowPriceVol++; continue; }
    passedCheap.push(t);
}

// Sort by Volume -> Take TOP 5 for Parallel Check
const shortlist = passedCheap.sort((a,b) => b.quoteVolume - a.quoteVolume).slice(0, 5);

// PARALLEL BOMBARDMENT (x5 requests at once)
const results = await Promise.all(shortlist.map(async (candidate) => {
    try {
        // 1. Depth Check
        const depth = await fetchMexcDepth(candidate.symbol, 20);
        if (!depth || !depth.bids.length) return null;
        const bestBid = Number(depth.bids[0][0]);
        const bestAsk = Number(depth.asks[0][0]);
        const mid = (bestBid+bestAsk)/2;
        const spreadPct = ((bestAsk-bestBid)/mid)*100;
        if (spreadPct > gates.maxSpreadPct) return null;

        // 2. Klines Check
        const kl = await fetchMexcKlines(candidate.symbol, '1m', 35);
        const closes = kl.map(k=>Number(k[4]));
        if (closes.length < 35) return null;
        
        // Sawtooth check
        let flattens = 0;
        for(let i=2; i<closes.length; i++) { if(closes[i] === closes[i-2]) flattens++; }
        if (flattens > 5) { lastDemoteReasonCounts.sawtooth++; return null; }

        const ctx = kl.map(k=>({close:Number(k[4])}));

        // 3. DeepSeek Call
        const ds = await deepseekForecast5(candidate.symbol, ctx);
        if (!ds) return null; // Timeout or fail

        // 4. Confidence Check
        if (ds.confidence < 75) return null; 

        return { ...candidate, ...ds, spreadPct };
    } catch (e) { return null; }
}));

const valid = results.filter(r => r !== null);
valid.forEach(v => accepted.push(v));

if (accepted.length >= 1) break; 

}

lastAiPickCount = accepted.length;
return accepted.slice(0, 2);
}

// --- SCANNER JOB ---
async function runScannerJob() {
if (scanInFlight) return;
scanInFlight = true;
console.log('\n🔍 Running Elite Scanner Job...');

try {
const all = await fetch24hrTickers();
if (!all) throw new Error("MEXC API Fail");

text

const base = all.map(x => ({
  symbol: x.symbol, quoteVolume: Number(x.quoteVolume), lastPrice: Number(x.lastPrice), priceChangePercent: Number(x.priceChangePercent)
})).filter(x => x.symbol.endsWith('USDT') && isSaneUsdtSymbol(x.symbol) && !isStablecoinLike(x.symbol) && !isLeveraged(x.symbol) && !isTokenizedStock(x.symbol));

// Pools
const aiPool = base; 
const ftPool = base.filter(x => x.quoteVolume >= MIN_QUOTEVOL_FT && x.lastPrice >= MIN_PRICE_FT);

// 1. Pick AI (Fast Parallel)
const aiPicks = await pickAiWithAdaptiveGates(aiPool);
const aiSymbols = aiPicks.map(a => a.symbol);

// 2. Pick FT (RSI Logic)
const ftPicks = [];
const ftCandidates = ftPool.filter(x => !aiSymbols.includes(x.symbol)).sort((a,b) => Math.abs(b.priceChangePercent) - Math.abs(a.priceChangePercent)).slice(0, 60);

for (let i=0; i<ftCandidates.length; i+=CHUNK_SIZE) {
    const chunk = ftCandidates.slice(i, i+CHUNK_SIZE);
    await Promise.all(chunk.map(async (t) => {
        const kl = await fetchMexcKlines(t.symbol, '1m', 20);
        const closes = kl.map(k=>Number(k[4]));
        if (closes.length < 15) return;
        
        const rsi = calculateRSI(closes, 14);
        let signal = 'NEUTRAL';
        if (rsi < 35) signal = 'LONG';
        if (rsi > 65) signal = 'SHORT';

        // Keep only Signals or Active Volatile
        ftPicks.push({ ...t, rsi, signal, tag: 'FT', stdDev: relStdDevPct(closes) });
    }));
}

// Payload
const finalDetected = [];
const forecasts = {};

aiPicks.forEach(ai => {
    const now = Date.now();
    forecasts[ai.symbol] = {
        generatedAt: now, horizonMinutes: 5, candles: ai.forecastCandles, source: 'deepseek',
        target_price: ai.target_price, stop_loss_price: ai.stop_loss_price, direction: ai.direction
    };
    finalDetected.push({
        symbol: ai.symbol, tag: 'AI', price: ai.price, stdDev: ai.stdDev, quoteVolume: ai.quoteVolume,
        change24hPct: ai.priceChangePercent, detectedAt: now, expiresAt: now + 300000,
        signal: ai.direction, spreadPct: ai.spreadPct
    });
    forecastSourceBySymbol[ai.symbol] = 'deepseek';
});

ftPicks.slice(0, 20).forEach(ft => {
    finalDetected.push({
        symbol: ft.symbol, tag: 'FT', price: ft.lastPrice, stdDev: ft.stdDev, quoteVolume: ft.quoteVolume,
        change24hPct: ft.priceChangePercent, detectedAt: Date.now(), expiresAt: Date.now() + 600000,
        signal: ft.signal, rsi: ft.rsi
    });
});

console.log(`✅ Final: AI=${aiPicks.length}, FT=${ftPicks.length}`);

const now = Date.now();
const nextUpdate = now + UI_INTERVAL;
const sleepTime = Math.max(0, UI_INTERVAL - PRE_WORK_TIME);

const payload = {
    ts: new Date().toISOString(),
    nextScanAt: nextUpdate,
    parsed: { detected: finalDetected, forecastsBySymbol: forecasts }
};

fs.writeFileSync(DATA_FILE, JSON.stringify(payload));
sseBroadcast('scheduled_update', payload);

setTimeout(runScannerJob, sleepTime);

} catch (e) {
console.error('Scan Error:', e);
setTimeout(runScannerJob, 60000);
} finally {
scanInFlight = false;
}
}

// --- INIT ---
async function fetch24hrTickers() { return mexcFetchJSON('https://api.mexc.com/api/v3/ticker/24hr'); }
function sseBroadcast(evt, data) { sseClients.forEach(c => c.write(event: ${evt}\ndata: ${JSON.stringify(data)}\n\n)); }
const sseClients = new Set();

app.get('/events', (req, res) => {
res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', 'Connection': 'keep-alive', 'Access-Control-Allow-Origin': '*' });
sseClients.add(res);
if (fs.existsSync(DATA_FILE)) res.write(event: scheduled_update\ndata: ${fs.readFileSync(DATA_FILE, 'utf8')}\n\n);
});

app.get('/api/live/candles', async (req, res) => {
const kl = await fetchMexcKlines(req.query.symbol || 'BTCUSDT', '1m', req.query.limit || 100);
res.json(kl.map(k=>({time:Number(k[0])/1000,open:Number(k[1]),high:Number(k[2]),low:Number(k[3]),close:Number(k[4])})));
});

app.get('/api/live/stream', (req, res) => {
res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', 'Connection': 'keep-alive', 'Access-Control-Allow-Origin': '*' });
const sym = req.query.symbol || 'BTCUSDT';
const iv = setInterval(async () => {
const kl = await fetchMexcKlines(sym, '1m', 1);
if (kl.length) {
const k = kl[0];
res.write(event: candle_update\ndata: ${JSON.stringify({time:Number(k[0])/1000,open:Number(k[1]),high:Number(k[2]),low:Number(k[3]),close:Number(k[4])})}\n\n);
}
}, 2000);
req.on('close', () => clearInterval(iv));
});

app.get('/api/scheduler/latest', (req, res) => {
if (fs.existsSync(DATA_FILE)) res.json(JSON.parse(fs.readFileSync(DATA_FILE))); else res.json({});
});

app.listen(PORT, () => {
console.log(🚀 Server on ${PORT});
runScannerJob();
});

