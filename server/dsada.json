ROLE: Senior UI Designer.
GOAL: Create a beautiful "Spotlight Search" feature for coins.

**TASK 1: Create `src/components/SpotlightSearch.tsx`**
- **Trigger:** A floating button (FAB) in the bottom-right corner.
  - Icon: `Search`.
  - Style: Glassmorphism + Neon Violet Glow + Pulse effect.
- **Modal:** When clicked, open a centered Search Modal.
  - Overlay: Black/80 blur.
  - Input: Large, minimalistic search bar ("Type symbol...").
  - List: Filtered list of detected coins below.
  - Animations: Fade In / Scale Up.

**TASK 2: Integrate into `src/components/Layout.tsx`**
- Import and render `<SpotlightSearch onSelect={handleSelect} coins={coins} />` at the end of the layout.
- Ensure it works on Mobile and Desktop.

**CODE (`src/components/SpotlightSearch.tsx`):**

```tsx
import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Search, X, TrendingUp } from 'lucide-react';
import { DetectedCoin } from '../store/scannerStore';

interface Props {
  onSelect: (s: string) => void;
  coins: DetectedCoin[];
}

const SpotlightSearch: React.FC<Props> = ({ onSelect, coins }) => {
  const [isOpen, setIsOpen] = useState(false);
  const [query, setQuery] = useState('');

  const filtered = coins.filter(c => c.symbol.includes(query.toUpperCase())).slice(0, 5);

  return (
    <>
      {/* FAB TRIGGER */}
      <motion.button
        whileHover={{ scale: 1.1 }}
        whileTap={{ scale: 0.9 }}
        onClick={() => setIsOpen(true)}
        className="fixed bottom-6 right-6 z-50 p-4 bg-violet-600 rounded-full shadow-[0_0_20px_rgba(124,58,237,0.5)] text-white hover:bg-violet-500 transition-colors"
      >
        <Search size={24} />
      </motion.button>

      {/* MODAL */}
      <AnimatePresence>
        {isOpen && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
            <motion.div 
              initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
              onClick={() => setIsOpen(false)}
              className="absolute inset-0 bg-black/80 backdrop-blur-sm"
            />
            
            <motion.div 
              initial={{ opacity: 0, scale: 0.9, y: 20 }} 
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className="relative w-full max-w-lg bg-[#111] border border-white/10 rounded-2xl shadow-2xl overflow-hidden"
            >
              {/* INPUT */}
              <div className="flex items-center px-4 border-b border-white/10">
                <Search className="text-gray-500" size={20} />
                <input 
                  autoFocus
                  type="text" 
                  placeholder="Search Coin..." 
                  className="w-full bg-transparent p-4 text-lg text-white outline-none placeholder:text-gray-600 font-mono uppercase"
                  value={query}
                  onChange={(e) => setQuery(e.target.value)}
                />
                <button onClick={() => setIsOpen(false)}><X className="text-gray-500 hover:text-white" /></button>
              </div>

              {/* RESULTS */}
              <div className="p-2">
                {filtered.map(c => (
                  <button
                    key={c.symbol}
                    onClick={() => { onSelect(c.symbol); setIsOpen(false); }}
                    className="w-full flex items-center justify-between p-3 rounded-lg hover:bg-white/10 text-left transition-colors group"
                  >
                    <span className="font-bold text-gray-200 group-hover:text-white">{c.symbol}</span>
                    <div className="flex items-center gap-3">
                      <span className="text-xs text-gray-500 font-mono">${c.price}</span>
                      {c.tag === 'AI' && <span className="text-[10px] bg-violet-600 px-2 py-0.5 rounded text-white shadow-lg shadow-violet-500/50">AI</span>}
                    </div>
                  </button>
                ))}
                {filtered.length === 0 && (
                  <div className="p-4 text-center text-gray-600 text-sm">No coins found</div>
                )}
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>
    </>
  );
};

export default SpotlightSearch;

OUTPUT: Provide updated SpotlightSearch.tsx and integrate it into Layout.tsx.

