// --- HELPERS ---
function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

async function mexcFetchJSON(url) {
  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), 10000);
  try {
    const res = agent ? await fetch(url, { agent, signal: controller.signal }) : await fetch(url, { signal: controller.signal });
    clearTimeout(id);
    if (!res.ok) return null;
    return res.json();
  } catch (e) {
    return null;
  }
}

async function fetchMexcKlines(symbol, interval='1m', limit=50) {
  const url = `https://api.mexc.com/api/v3/klines?symbol=${encodeURIComponent(symbol)}&interval=${interval}&limit=${limit}`;
  const data = await mexcFetchJSON(url);
  return Array.isArray(data) ? data : [];
}

async function fetchMexcDepth(symbol, limit=20) {
  const url = `https://api.mexc.com/api/v3/depth?symbol=${encodeURIComponent(symbol)}&limit=${limit}`;
  return mexcFetchJSON(url);
}

function isSaneUsdtSymbol(sym) {
  return /^[A-Z0-9]{2,}USDT$/.test(sym);
}

function isStablecoinLike(sym) {
  return /USDC|USDP|TUSD|DAI|FDUSD|USD1|USDE|PAXG|EUR|GBP/.test(sym);
}

function isLeveraged(sym) {
  return /(3L|3S|5L|5S|UP|DOWN|BULL|BEAR)USDT$/.test(sym);
}

function isTokenizedStock(sym) {
  return /ONUSDT$/.test(sym);
}

function computeStdDev(values) {
  if (!values.length) return 0;
  const mean = values.reduce((s, v) => s + v, 0) / values.length;
  const variance = values.reduce((s, v) => s + (v - mean) * (v - mean), 0) / values.length;
  return Math.sqrt(variance);
}

function relStdDevPct(closes) {
  if (!closes.length) return 999;
  const mean = closes.reduce((s,v)=>s+v,0)/closes.length;
  if (!mean) return 999;
  return (computeStdDev(closes) / mean) * 100;
}

function calculateRSI(closes, period=14) {
  if (closes.length < period + 1) return 50;
  let gains = 0, losses = 0;
  for (let i = 1; i <= period; i++) {
    const change = closes[i] - closes[i - 1];
    if (change > 0) gains += change; else losses -= change;
  }
  let avgGain = gains / period;
  let avgLoss = losses / period;
  
  for (let i = period + 1; i < closes.length; i++) {
    const change = closes[i] - closes[i - 1];
    avgGain = (avgGain * (period - 1) + (change > 0 ? change : 0)) / period;
    avgLoss = (avgLoss * (period - 1) + (change < 0 ? -change : 0)) / period;
  }
  
  if (avgLoss === 0) return 100;
  const rs = avgGain / avgLoss;
  return 100 - (100 / (1 + rs));
}

// --- DEEPSEEK (FIXED PARSING) ---
async function deepseekForecast5(symbol, contextCandles) {
  if (!SILICON_KEY) return null;

  // Strict JSON Prompt
  const system = `You are an elite crypto sniper. Analyze patterns. Identify a PRICE TARGET the asset will TOUCH within 5 mins. Also set a STOP LOSS based on ATR.
REQUIRED JSON OUTPUT:
{
  "target_price": <number>,
  "stop_loss_price": <number>,
  "direction": "LONG" | "SHORT",
  "confidence": <number 0-100>,
  "forecast_1m": [
    {"offset_minutes": 1, "close": <number>},
    {"offset_minutes": 2, "close": <number>},
    {"offset_minutes": 3, "close": <number>},
    {"offset_minutes": 4, "close": <number>},
    {"offset_minutes": 5, "close": <number>}
  ]
}`;

  const user = `Symbol: ${symbol}. Last close: ${contextCandles[contextCandles.length-1].close}. Recent 30m closes: ${contextCandles.map(c=>c.close).join(',')}. Predict now.`;

  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), 25000); // 25s timeout

  try {
    const r = await fetch('https://api.siliconflow.cn/v1/chat/completions', {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${SILICON_KEY}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: 'deepseek-ai/DeepSeek-V3',
        messages: [{ role: 'system', content: system }, { role: 'user', content: user }],
        temperature: 0.1, // High precision
        response_format: { type: 'json_object' }
      }),
      signal: controller.signal
    });
    clearTimeout(id);

    if (!r.ok) return null;

    const j = await r.json();
    const content = j?.choices?.[0]?.message?.content;
    const parsed = JSON.parse(content || '{}');
    
    // Strict Validation
    if (!parsed.target_price || !parsed.stop_loss_price || !parsed.forecast_1m || parsed.forecast_1m.length < 5) return null;

    const now = Date.now();
    const candles = parsed.forecast_1m.slice(0,5).map((c, i) => ({
       t: now + (i+1)*60000,
       close: Number(c.close)
    }));

    return {
        candles,
        target_price: Number(parsed.target_price),
        stop_loss_price: Number(parsed.stop_loss_price),
        direction: parsed.direction,
        confidence: Number(parsed.confidence)
    };

  } catch (e) {
    return null; 
  }
}

// --- ADAPTIVE PICKER (FAST) ---
async function pickAiWithAdaptiveGates(aiPool) {
  // Relaxed Gates for Speed
  const adaptiveSteps = [
    { name: 'step1', gates: { maxSpreadPct: 0.25, minDepth: 15_000, stddevMax: 0.20 } },
    { name: 'step2', gates: { maxSpreadPct: 0.35, minDepth: 10_000, stddevMax: 0.28 } },
  ];

  const accepted = [];
  const pool = aiPool.slice();
  const majors = ['BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT', 'XRPUSDT'];

  for (const step of adaptiveSteps) {
    const passedCheap = [];
    const gates = step.gates;

    for (const t of pool) {
        if (majors.includes(t.symbol)) continue; 
        if (t.quoteVolume < MIN_QUOTEVOL_AI) { lastDemoteReasonCounts.lowPriceVol++; continue; }
        if (t.lastPrice < MIN_PRICE_AI) { lastDemoteReasonCounts.lowPriceVol++; continue; }
        passedCheap.push(t);
    }

    // Sort by Volume -> Take TOP 5 for Parallel Check
    const shortlist = passedCheap.sort((a,b) => b.quoteVolume - a.quoteVolume).slice(0, 5);
    
    // PARALLEL BOMBARDMENT (x5 requests at once)
    const results = await Promise.all(shortlist.map(async (candidate) => {
        try {
            // 1. Depth Check
            const depth = await fetchMexcDepth(candidate.symbol, 20);
            if (!depth || !depth.bids.length) return null;
            const bestBid = Number(depth.bids[0][0]);
            const bestAsk = Number(depth.asks[0][0]);
            const mid = (bestBid+bestAsk)/2;
            const spreadPct = ((bestAsk-bestBid)/mid)*100;
            if (spreadPct > gates.maxSpreadPct) return null;

            // 2. Klines Check
            const kl = await fetchMexcKlines(candidate.symbol, '1m', 35);
            const closes = kl.map(k=>Number(k[4]));
            if (closes.length < 35) return null;
            
            // Sawtooth check
            let flattens = 0;
            for(let i=2; i<closes.length; i++) { if(closes[i] === closes[i-2]) flattens++; }
            if (flattens > 5) { lastDemoteReasonCounts.sawtooth++; return null; }

            const ctx = kl.map(k=>({close:Number(k[4])}));

            // 3. DeepSeek Call
            const ds = await deepseekForecast5(candidate.symbol, ctx);
            if (!ds) return null; // Timeout or fail

            // 4. Confidence Check
            if (ds.confidence < 75) return null; 

            return { ...candidate, ...ds, spreadPct };
        } catch (e) { return null; }
    }));

    const valid = results.filter(r => r !== null);
    valid.forEach(v => accepted.push(v));

    if (accepted.length >= 1) break; 
  }

  lastAiPickCount = accepted.length;
  return accepted.slice(0, 2);
}

// --- SCANNER JOB ---
async function runScannerJob() {
  if (scanInFlight) return;
  scanInFlight = true;
  console.log('\n🔍 Running Elite Scanner Job...');

  try {
    const all = await fetch24hrTickers();
