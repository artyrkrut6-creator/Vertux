React

import React, { useEffect, useState } from 'react';
import Sidebar from './Sidebar';
import ChartContainer from './ChartContainer';
import SmartSearchButton from './SmartSearchButton';
import useMarketScanner from '../hooks/useMarketScanner';
import useScannerStore, { DetectedCoin } from '../store/scannerStore';
import mexcService from '../services/mexcService';

export const Layout: React.FC = () => {
  const [selected, setSelected] = useState<string | undefined>(undefined);

  // Background scanner hook (disabled here because server does the job via SSE)
  useMarketScanner({ enabled: false });
  
  const coins = useScannerStore((s) => s.coins || []);
  const addDetectedCoin = useScannerStore((s) => s.addDetectedCoin);

  // 1. Auto-select default coin on mount if none selected
  useEffect(() => {
    if (!selected) {
      setSelected('BTCUSDT');
    }
  }, []);

  // 2. Main Logic: SSE Connection & Data Parsing
  useEffect(() => {
    let es: EventSource | null = null;
    let mounted = true;

    // --- A. Fetch Initial Data (Snapshot) ---
    const fetchInitial = async () => {
      try {
        const r = await fetch('/api/scheduler/latest');
        if (r.ok) {
          const data = await r.json();
          if (!mounted) return;
          processIncomingData(data);
        }
      } catch (e) {
        console.warn('[Layout] Initial fetch failed:', e);
      }
    };
    fetchInitial();

    // --- B. Helper: Universal Data Parser ---
    const processIncomingData = async (data: any) => {
      console.log('[Layout] Incoming Data:', data);

      // Robust extraction: look in all possible places where the list might be hidden
      const parsedData = data.parsed || data;
      const list = parsedData.detected || parsedData.detectedSymbols || [];

      console.log('[Layout] Extracted List:', list);

      if (!Array.isArray(list)) return;

      const now = Date.now();

      for (const item of list) {
        try {
          // Normalize Item: could be string "BTCUSDT" or object { symbol: "...", ... }
          let sym = '';
          let score = 0;
          let price = 0;

          if (typeof item === 'string') {
            sym = item;
          } else {
            sym = item.symbol || item.ticker;
            score = Number(item.score || item.stdDev || item.std || 0);
            price = Number(item.price || item.lastPrice || 0);
          }

          if (!sym) continue;
          sym = sym.toUpperCase();

          // If price is missing, fetch it
          if (!price) {
            try {
              price = await mexcService.fetchTickerPrice(sym);
            } catch (err) {
               // ignore fetch error
            }
          }

          // Update Store
          const coin: DetectedCoin = {
            symbol: sym,
            detectedAt: now, // refresh timestamp
            expiresAt: now + 5 * 60 * 1000, // +5 mins
            stdDev: score,
            price: price || 0,
          };
          
          addDetectedCoin(coin);

        } catch (e) {
          console.error('[Layout] Error processing item:', item, e);
        }
      }
    };

    // --- C. Start SSE Connection ---
    try {
      const url = '/events'; 
      console.log('[Layout] Connecting SSE:', url);
      
      const esCandidate = new EventSource(url);
      es = esCandidate;

      es.addEventListener('open', () => console.log('[Layout] SSE Open'));
      es.addEventListener('connected', () => console.log('[Layout] SSE Handshake OK'));
      
      es.addEventListener('scheduled_update', (ev: MessageEvent) => {
        try {
          const data = JSON.parse(ev.data);
          processIncomingData(data);
        } catch (e) {
          console.error('[Layout] SSE Parse Error:', e);
        }
      });

      es.addEventListener('error', (e) => {
        // SSE often errors on refresh, just warn
        // console.warn('[Layout] SSE Error:', e);
      });

    } catch (e) {
      console.error('[Layout] SSE Setup Failed:', e);
    }

    return () => {
      mounted = false;
      if (es) es.close();
    };
  }, []);

  // 3. Auto-select first detected coin if we are on default but found something new
  useEffect(() => {
    if ((!selected || selected === 'BTCUSDT') && coins.length > 0) {
      // Optional: Auto-switch to the newest found coin? 
      // setSelected(coins[0].symbol); // Uncomment if you want auto-switch
    }
  }, [coins]);

  const handleSelect = (s: string) => setSelected(s);

  return (
    <div className="min-h-screen bg-[#050505] text-white">
      <div className="max-w-[1280px] mx-auto flex gap-6">
        
        {/* Sidebar Fixed Left */}
        <Sidebar onSelect={handleSelect} selected={selected} />

        {/* Main Content */}
        <main className="flex-1 p-4 overflow-hidden">
          {/* Chart Area */}
          <div className="relative w-full h-[500px] rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm p-4">
             <ChartContainer symbol={selected ?? 'BTCUSDT'} />
          </div>
        </main>

      </div>
      
      {/* Floating Action Button */}
      <SmartSearchButton onSelect={handleSelect} />
    </div>
  );
};

export default Layout;

